{"actor":"server","event":"response","topic_id":"2024-152259","model_call":36,"request":{"op":"query","query":"(^ \"goth rock\" (+ darkness depravity alienation despair death) (+ lyrics themes))"},"record":{"query":{"op":"query","query":"(^ \"goth rock\" (+ darkness depravity alienation despair death) (+ lyrics themes))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_01_1346695066#6_1842370242","ok":true,"op":"query","qid":"q2367","rank":1,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_01_1346695066#6_1842370242\" , \"end_char\": 4008.000000 , \"headings\": \"History and Styles of Heavy Metal History and Styles of Heavy Metal Exploring the subgenres History Musical and Vocal Styles Genres The Future \" , \"segment\": \"Examples: Candlemass, Pentagram, Saint Vitus, Solstice Gothic Metal A combination of the <cover>darkness and melancholy of goth rock with heavy metal. The lyrics </cover>tend to be epic and melodramatic. This is a genre that uses a lot of male/female vocal combinations with the male vocalist generally using more aggressive vocals and the female singing in an ethereal soprano. Examples: Lacuna Coil, Leaves Eyes, Theatre Of Tragedy, Tristania. Grindcore This is a genre influenced by thrash metal and death metal. It takes its name from the sound of the atonal guitar riffs combined with blast beats from the bass drum. The vocals are similar to death metal. Examples:\" , \"start_char\": 3352.000000 , \"title\": \"History, Styles and Subgenres of Heavy Metal\" , \"url\": \"","skipped":[{"docno":"msmarco_v2.1_doc_01_1346695066#6_1842370242","rank":1,"relevance":1}]},"time":156},"model_calls":36,"document_judgments":27,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
