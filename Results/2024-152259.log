{"actor":"server","event":"response","topic_id":"2024-152259","model_call":40,"request":{"op":"next","qid":"q2371"},"record":{"query":{"op":"next","qid":"q2371"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_16_2086543235#0_2313323512","ok":true,"op":"next","qid":"q2371","rank":5,"snippet":"<cover>Gothic rock Rock and roll Glam rock Hard rock Horror punk Length 48:38 Label Nuclear Blast (Europe) The End Records (USA) AmpHead Music (Australia) EMI (Finland) Producer Matt Hyde The 69 Eyes chronology Angels (2007) Back in Blood (2009) X (2012) Professional ratings Review scores Source Rating Type 3 Media Metal Hammer Allmusic Back in Blood is the ninth studio album from Finnish goth rock band The 69 Eyes and their first to be released via Nuclear Blast in Europe and The End Records in North America. The album was recorded in both Helsinki and Los Angeles and produced by Matt Hyde. The cover art was designed by Estevan Oriol. Lyrically, the whole album deals with themes of vampires and blood. Contents 1 Track listing 1.1 Bonus DVD Vampire Edition 2 Charts 3 Singles 4 Miscellaneous 5 References Track listing \"Back in Blood\" – 4:30 \"We Own The Night\" – 4:03 \"Dead N' Gone\" (feat. Benji Madden) – 3:40 \"The Good, the Bad & the Undead\" – 3:28 \"Kiss Me Undead\" – 3:58 \"Lips of Blood\" – 4:21 \"Dead Girls Are Easy\" – 3:55 \"Night Watch\" – 4:33 \"Some Kind of Magick\" – 3:43 \"Hunger\" – 4:34 \"Suspiria Snow </cover>","skipped":[{"docno":"msmarco_v2.1_doc_17_237360052#8_262516369","rank":1,"relevance":1},{"docno":"msmarco_v2.1_doc_17_237360052#7_262514012","rank":2,"relevance":1},{"docno":"msmarco_v2.1_doc_17_1236837256#1_1363400322","rank":3,"relevance":3},{"docno":"msmarco_v2.1_doc_18_2821331992#0_3214214812","rank":4,"relevance":1}]},"time":7},"model_calls":40,"document_judgments":29,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
