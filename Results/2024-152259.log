{"actor":"server","event":"response","topic_id":"2024-152259","model_call":17,"request":{"op":"next","qid":"q2349"},"record":{"query":{"op":"next","qid":"q2349"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_17_3261615973#0_3374559745","ok":true,"op":"next","qid":"q2349","rank":2,"snippet":"\"List of gothic metal bands List of gothic metal bands Contents List of bands See also References Notes External links \" , \"segment\": \"List of gothic metal bands - Wikipedia List of gothic metal bands From Wikipedia, the free encyclopedia Jump to navigation Jump to search Type O Negative at the 2007 Gods of Metal festival. This is a list of gothic metal bands. Gothic metal is a genre of heavy metal music. It is characterized as a combination of the dark atmosphere of <cover>gothic rock with the aggression of heavy metal music. The genre originated during the early 1990s in Europe as an outgrowth of death/</cover>doom, a fusion of death metal, doom metal, and gothic rock. The music of gothic metal is diverse with bands known to adopt the gothic approach to different styles of heavy metal music. Lyrics are generally melodramatic and dark with inspiration from gothic fiction as well as personal experiences. Members of metal bands such as After Forever, HIM and Nightwish have downplayed or dismissed the gothic label from their music. The issue is obscured further by bands that have since moved away from gothic metal or even heavy metal ","skipped":[{"docno":"msmarco_v2.1_doc_17_237360052#8_262516369","rank":1,"relevance":1}]},"time":10},"model_calls":17,"document_judgments":13,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
