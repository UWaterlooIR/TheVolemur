{"actor":"server","event":"response","topic_id":"2024-223358","model_call":75,"request":{"op":"query","query":"(^ watermelons (+ \"delayed harvest\" \"late harvest\" \"delayed planting\" \"late planting\") (+ rain weather supply prices shortage))"},"record":{"query":{"op":"query","query":"(^ watermelons (+ \"delayed harvest\" \"late harvest\" \"delayed planting\" \"late planting\") (+ rain weather supply prices shortage))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_01_1455245609#14_2038525248","ok":true,"op":"query","qid":"q2797","rank":1,"snippet":"Best Mortgage Rate for You Watermelon Plant Growing Tips Boron for Watermelons \" , \"segment\": \"An element called boron is known to help make watermelons sweeter. Boron for watermelons helps increase sweetness of the fruits when given as a dose of 1 tablespoon in 1 gallon of water. Spray this mixture on the foliage and the base of the plants, says Burpee. The University of Arkansas Division of Agriculture points to boron deficiency as a cause of poor flavor and lack of sweetness. Lack of sweetness is not caused by low sugar due to watermelons crossing with other vine crops in the garden. While watermelon varieties will cross with one another, they will not cross with squash, pumpkin or cucumbers (plants that are in the same family as watermelons). If you are experiencing lack of sweetness with your <cover>watermelons, the problem could be wilting vines, high rainfall, cool weather or late planting.</cover>\" , \"start_char\": 7231.000000 , \"title\": \"What to Use to Fertilize Watermelon | Home Guides | SF Gate\" , \"url\": \"http://homeguides.sfgate.com/fertilize-watermelon-65777.html\" }","skipped":[{"docno":"msmarco_v2.1_doc_01_1455245609#14_2038525248","rank":1,"relevance":1}]},"time":181},"model_calls":75,"document_judgments":38,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
