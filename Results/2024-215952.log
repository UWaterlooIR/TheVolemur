{"actor":"server","event":"response","topic_id":"2024-215952","model_call":76,"request":{"op":"next","qid":"q2632"},"record":{"query":{"op":"next","qid":"q2632"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_23_775302119#1_1715664794","ok":true,"op":"next","qid":"q2632","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_23_775302119#1_1715664794\" , \"end_char\": 1539.000000 , \"headings\": \"Maximilien Robespierre Quotes Maximilien Robespierre Quotes\" , \"segment\": \"Maximilien Robespierre Source Report... It is with regret that I pronounce the <cover>fatal truth: Louis must die that the country may live. Maximilien Robespierre</cover>Source Report... Lf the attribute of popular government in peace is virtue, the attribute of popular government in revolution is at one and the same time virtue and terror, virtue without which terror is fatal, terror without which virtue is impotent. The terror is nothing but justice, prompt, severe, inflexible; it is thus an emanation of virtue. Maximilien Robespierre Source Report... Terror is nothing other than prompt, stern, inflexible justice; terror thus issues from virtue; it is less a particular maxim than a consequence of the general principle of democracy applied to the most pressing needs of the fatherland. Maximilien Robespierre Source Report... Intimidation without virtue is disastrous; virtue without intimidation is powerless.\" , \"start_char\": 630.000000 , \"title\": \"Maximilien Robespierre (","skipped":[{"docno":"msmarco_v2.1_doc_23_775302119#1_1715664794","rank":2,"relevance":2}]},"time":6},"model_calls":76,"document_judgments":46,"relevance_3":20,"max_document_judgments":50,"max_model_calls":100}
