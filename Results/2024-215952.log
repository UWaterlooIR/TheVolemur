{"actor":"server","event":"response","topic_id":"2024-215952","model_call":24,"request":{"op":"next","qid":"q2595"},"record":{"query":{"op":"next","qid":"q2595"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_42_1190159462#4_2684254905","ok":true,"op":"next","qid":"q2595","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_42_1190159462#4_2684254905\" , \"end_char\": 3247.000000 , \"headings\": \"EXECUTION OF LOUIS XVI EXECUTION OF LOUIS XVI\" , \"segment\": \"Next, on January 15th, 1793, the representatives voted and passed their verdict of guilty. The famous revolutionary, Maximilien <cover>Robespierre, commented that “Louis must die so the nation may live.” </cover>Louis’ punishment was death and on, January 21st, 1793, he was beheaded by guillotine. His final words were said to be: “ I pardon those who are the cause of my death and declare myself innocent of all of the charges brought against me.” The French monarchy, which had lasted for over 1000 years was over.\" , \"start_char\": 2746.000000 , \"title\": \"Execution of Louis XVI - History Crunch - History Articles, Summaries, Biographies, Resources and More\" , \"url\": \"https://www.historycrunch.com/execution-of-louis-xvi.html\" }","skipped":[{"docno":"msmarco_v2.1_doc_42_1190159462#3_2684253494","rank":1,"relevance":3}]},"time":4},"model_calls":24,"document_judgments":17,"relevance_3":9,"max_document_judgments":50,"max_model_calls":100}
