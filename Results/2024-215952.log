{"actor":"server","event":"response","topic_id":"2024-215952","model_call":24,"request":{"op":"query","query":"(^ robespierre \"louis must die so the nation may live\")"},"record":{"query":{"op":"query","query":"(^ robespierre \"louis must die so the nation may live\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_42_1190159462#3_2684253494","ok":true,"op":"query","qid":"q2595","rank":1,"snippet":"would prove to be important as it would be the deciding factor in the National Convention’s decision to convict and execute the king. Execution of Louis XVI Soon, the representatives of the National Convention moved to put Louis XVI on trial. On December 11th, 1792, the king was brought before the convention to hear the charges against him. He was charged with treason due to his attempt to flee the country, which was viewed as him abandoning his country. Next, on January 15th, 1793, the representatives voted and passed their verdict of guilty. The famous revolutionary, Maximilien <cover>Robespierre, commented that “Louis must die so the nation may live.” </cover>Louis’ punishment was death and on, January 21st, 1793, he was beheaded by guillotine. His final words were said to be: “ I pardon those who are the cause of my death and declare myself innocent of all of the charges brought against me.”\" , \"start_char\": 2160.000000 , \"title\": \"Execution of Louis XVI - History Crunch - History Articles, Summaries, Biographies, Resources and More\" , \"url\": \"https://www.historycrunch.com/execution-of-louis-xvi.html\" }","skipped":[{"docno":"msmarco_v2.1_doc_42_1190159462#3_2684253494","rank":1,"relevance":3}]},"time":320},"model_calls":24,"document_judgments":17,"relevance_3":9,"max_document_judgments":50,"max_model_calls":100}
