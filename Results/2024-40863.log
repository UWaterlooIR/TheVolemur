{"actor":"server","event":"response","topic_id":"2024-40863","model_call":52,"request":{"op":"next","qid":"q1084"},"record":{"query":{"op":"next","qid":"q1084"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_25_1463836094#9_2825253470","ok":true,"op":"next","qid":"q1084","rank":3,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_25_1463836094#9_2825253470\" , \"end_char\": 6016.000000 , \"headings\": \"Insect Bites and Stings Insect Bites and Stings This article is for Medical Professionals<cover>Hymenoptera stings Systemic reaction to wasp or bee stings Investigation of patients with bee or wasp sting allergy Treatment of patients with bee or wasp sting allergy Management of bee or wasp stings Blood-sucking flies True bugs (Hemiptera) Ticks (Ixodoidea) Management Harvest mites (Trombiculidae) Join our weekly wellness digest from the best health experts in the business \" , \"segment\": \"Venom immunotherapy (VIT) is recommended for all patients with a severe systemic reaction after a sting. It reduces the chances of a serious allergic reaction to an insect sting and improves quality of life. </cover>VIT is the only specific treatment that is currently available for patients with a history of systemic reaction to a Hymenoptera insect sting. VIT is effective in 95% of patients allergic to wasp venom and about 80% of those allergic to bee venom. VIT is not often recommended for children. A Cochrane review found that approximately ","skipped":[{"docno":"msmarco_v2.1_doc_25_1463836094#9_2825253470","rank":3,"relevance":3}]},"time":9},"model_calls":52,"document_judgments":31,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
