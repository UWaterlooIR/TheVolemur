{"actor":"server","event":"response","topic_id":"2024-40863","model_call":45,"request":{"op":"next","qid":"q1077"},"record":{"query":{"op":"next","qid":"q1077"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_28_1612021813#0_3269334906","ok":true,"op":"next","qid":"q1077","rank":10,"snippet":"Allergies Stinging Insects Seasonal Allergies Asthma Nasal Polyps Allergic Skin Conditions Drug Allergies Our Treatments Our Physicians Affiliated Hospitals \" , \"segment\": \"St. Paul Allergy and Asthma – Diplomats of the American Board of Allergy & Immunology Welcome to St. Paul Allergy & Asthma St. Paul Allergy & Asthma is an established <cover>Allergy and Immunology practice that specializes in the diagnosis and management of allergies, asthma, and immunological disease in children and adults. Our physicians practice up-to-date evidence-based medicine, and incorporate the latest innovations in our field. We truly care about our patients and provide tailored and personalized medical care. Our practice offers a wide range of services with innovative treatments for food allergies, seasonal allergies, pet allergies, asthma, nasal polyps, bee sting/venom allergies, hives/angioedema, eczema, and multiple other conditions. We would love to have the opportunity to improve your quality of life. </cover>Please call or schedule online to make an appointment. Patient quick links: Patient Portal Request an Appointment Pay My Bill Our Services and Treatments Food Allergies We diagnose and treat food allergies including milk/dairy, eggs, peanut, tree nuts, fish, shellfish and others. Learn More Stinging Insects We offer venom immunotherapy to ","skipped":[{"docno":"msmarco_v2.1_doc_28_1612021813#0_3269334906","rank":10,"relevance":1}]},"time":8},"model_calls":45,"document_judgments":29,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
