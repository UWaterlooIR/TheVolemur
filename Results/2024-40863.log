{"actor":"server","event":"response","topic_id":"2024-40863","model_call":96,"request":{"op":"query","query":"(^ \"venom allergy\" (+ anxiety fear) (+ immunotherapy stings bee wasp hymenoptera))"},"record":{"query":{"op":"query","query":"(^ \"venom allergy\" (+ anxiety fear) (+ immunotherapy stings bee wasp hymenoptera))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_07_571733127#11_990044617","ok":true,"op":"query","qid":"q1122","rank":1,"snippet":"Tight Throat Feels Tight Causes and Treatments for Throat Tightness 1. Anxiety 2. Thyroid Problems 3. Acid Reflux 4. Food Allergy 5. Medication Allergy 6. Insect Venom Allergy When to See a Doctor \" , \"segment\": \"Your healthcare provider may prescribe an EpiPen for severe reactions. If you develop severe throat tightness or shortness of breath, call for medical assistance. 6. Insect Venom Allergy Most people do not react to an insect bite or sting; however, some people have a true allergy to the venom injected when an insect bites or <cover>stings. Throat tightness after an insect sting is a true medical emergency. You may notice swelling or itching in your throat followed by shortness of breath, anxiety and confusion. Treatment for insect venom allergy </cover>includes avoiding the insects. If you are stung, remove the stinger. Keep the area of the sting below the level of your heart if possible.\" , \"start_char\": 4966.000000 , \"title\": \"Causes and Treatments of Tight Feelings in Throat | Just-Health.net\" , \"url\": \"http://www.just-health.net/Throat-Feels-Tight.html\" }"},"time":49},"model_calls":96,"document_judgments":48,"relevance_3":9,"max_document_judgments":50,"max_model_calls":100}
