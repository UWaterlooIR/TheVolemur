{"actor":"server","event":"response","topic_id":"2024-40863","model_call":42,"request":{"op":"query","query":"(^ hymenoptera venom allergic \"quality of life\")"},"record":{"query":{"op":"query","query":"(^ hymenoptera venom allergic \"quality of life\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_25_1463836094#9_2825253470","ok":true,"op":"query","qid":"q1076","rank":1,"snippet":"wasp sting allergy Treatment of patients with bee or wasp sting allergy Management of bee or wasp stings Blood-sucking flies True bugs (Hemiptera) Ticks (Ixodoidea) Management Harvest mites (Trombiculidae) Join our weekly wellness digest from the best health experts in the business \" , \"segment\": \"Venom immunotherapy (VIT) is recommended for all patients with a severe systemic reaction after a sting. It reduces the chances of a serious allergic reaction to an insect sting and improves <cover>quality of life. VIT is the only specific treatment that is currently available for patients with a history of systemic reaction to a Hymenoptera insect sting. VIT is effective in 95% of patients allergic to wasp venom </cover>and about 80% of those allergic to bee venom. VIT is not often recommended for children. A Cochrane review found that approximately 1 in 10 people treated had an allergic reaction during their treatment. The usual duration of VIT is three years in the UK. All patients should be advised of measures to reduce their risk of future stings. These include: Wear light-coloured clothing.\" , \"start_char\": 5223.000000 , \"title\": \"","skipped":[{"docno":"msmarco_v2.1_doc_25_1463836094#9_2825253470","rank":1,"relevance":3}]},"time":61},"model_calls":42,"document_judgments":26,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"request","topic_id":"2024-40863","model_call":42,"request":{"op":"next","qid":"q1076"},"model_calls":42,"document_judgments":26,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-40863","model_call":42,"request":{"op":"next","qid":"q1076"},"record":{"query":{"op":"next","qid":"q1076"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_25_1463836094#8_2825251705","ok":true,"op":"next","qid":"q1076","rank":2,"snippet":"often positive than serum-specific IgE and correlate better with history. Baseline tryptase should be measured. Those with raised levels have a higher risk of severe systemic reactions. Treatment of patients with bee or wasp sting allergy All patients with a history of systemic reaction should be immediately provided with a written emergency management plan, an adrenaline (epinephrine) auto-injector and education in its use. With children, appropriate liaison with the school is recommended. Venom immunotherapy (VIT) is recommended for all patients with a severe systemic reaction after a sting. It reduces the chances of a serious allergic reaction to an insect sting and improves <cover>quality of life. VIT is the only specific treatment that is currently available for patients with a history of systemic reaction to a Hymenoptera insect sting. VIT is effective in 95% of patients allergic to wasp venom </cover>and about 80% of those allergic to bee venom. VIT is not often recommended for children.\" , \"start_char\": 4702.000000 , \"title\": \"Insect Bites and Stings Treatment Information | Patient\" , \"url\": \"https://patient.info/doctor/insect-bites-and-stings-pro\" }","skipped":[{"docno":"msmarco_v2.1_doc_25_1463836094#8_2825251705","rank":2,"relevance":3}]},"time":7},"model_calls":42,"document_judgments":26,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
