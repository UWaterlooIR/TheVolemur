{"actor":"server","event":"response","topic_id":"2024-40863","model_call":57,"request":{"op":"query","query":"(^ (+ bee wasp) \"sting allergy\" \"improves quality of life\")"},"record":{"query":{"op":"query","query":"(^ (+ bee wasp) \"sting allergy\" \"improves quality of life\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_25_1463836094#8_2825251705","ok":true,"op":"query","qid":"q1089","rank":1,"snippet":"Management Harvest mites (Trombiculidae) Join our weekly wellness digest from the best health experts in the business \" , \"segment\": \"Skin tests are also more often positive than serum-specific IgE and correlate better with history. Baseline tryptase should be measured. Those with raised levels have a higher risk of severe systemic reactions. Treatment of patients with bee or <cover>wasp sting allergy All patients with a history of systemic reaction should be immediately provided with a written emergency management plan, an adrenaline (epinephrine) auto-injector and education in its use. With children, appropriate liaison with the school is recommended. Venom immunotherapy (VIT) is recommended for all patients with a severe systemic reaction after a sting. It reduces the chances of a serious allergic reaction to an insect sting and improves quality of life. </cover>VIT is the only specific treatment that is currently available for patients with a history of systemic reaction to a Hymenoptera insect sting. VIT is effective in 95% of patients allergic to wasp venom and about 80% of those allergic to bee venom. VIT is not often recommended for children.\" , \"start_char\": 4702.000000 , \"","skipped":[{"docno":"msmarco_v2.1_doc_25_1463836094#8_2825251705","rank":1,"relevance":3}]},"time":35},"model_calls":57,"document_judgments":32,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
