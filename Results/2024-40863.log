{"actor":"server","event":"response","topic_id":"2024-40863","model_call":87,"request":{"op":"next","qid":"q1115"},"record":{"query":{"op":"next","qid":"q1115"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_56_778278917#17_1605640225","ok":true,"op":"next","qid":"q1115","rank":3,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_56_778278917#17_1605640225\" , \"end_char\": 4428.000000 , \"headings\": \" Bee, yellow jacket, wasp, and other Hymenoptera stings: Reaction types and acute management Author: Section Editor: Deputy Editor: INTRODUCTION OVERVIEW To continue reading this article, you must log in with your personal, hospital, or group practice subscription. REFERENCES \" , \"segment\": \"Allergy 2019; 74:1969. Oude Elberink JN, De Monchy JG, Van Der Heide S, et al. Venom immunotherapy improves health-related <cover>quality of life in patients allergic to yellow jacket venom. J Allergy Clin Immunol 2002; 110:174. deShazo RD, Griffing C, Kwan TH, et al. Dermal hypersensitivity reactions to imported fire ants. J Allergy Clin Immunol 1984; 74:841.\" , \"start_char\": 4073.000000 , \"title\": \"Bee, yellow jacket, wasp, and other Hymenoptera </cover>stings: Reaction types and acute management - UpToDate\" , \"url\": \"https://www.uptodate.com/contents/bee-yellow-jacket-wasp-and-other-hymenoptera-stings-reaction-types-and-acute-management\" }","skipped":[{"docno":"msmarco_v2.1_doc_56_778278917#17_1605640225","rank":3,"relevance":2}]},"time":6},"model_calls":87,"document_judgments":43,"relevance_3":9,"max_document_judgments":50,"max_model_calls":100}
