{"actor":"server","event":"response","topic_id":"2024-40863","model_call":3,"request":{"op":"next","qid":"q1046"},"record":{"query":{"op":"next","qid":"q1046"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_25_1463836094#9_2825253470","ok":true,"op":"next","qid":"q1046","rank":2,"snippet":"to wasp or bee stings Investigation of patients with bee or wasp sting allergy Treatment of patients with bee or wasp sting allergy Management of bee or wasp stings Blood-sucking flies True bugs (Hemiptera) Ticks (Ixodoidea) Management Harvest mites (Trombiculidae) Join our weekly wellness digest from the best health experts in the business \" , \"segment\": \"Venom immunotherapy (VIT) is recommended for all patients with a severe systemic reaction after a sting. It reduces the chances of a serious <cover>allergic reaction to an insect sting and improves quality of life. VIT is the only specific treatment that is currently available for patients with a history of systemic reaction to a Hymenoptera </cover>insect sting. VIT is effective in 95% of patients allergic to wasp venom and about 80% of those allergic to bee venom. VIT is not often recommended for children. A Cochrane review found that approximately 1 in 10 people treated had an allergic reaction during their treatment. The usual duration of VIT is three years in the UK. All patients should be advised of measures to reduce their risk of future stings. These include: Wear light-coloured clothing.\" , \"start_char\""},"time":16},"model_calls":3,"document_judgments":2,"relevance_3":1,"max_document_judgments":50,"max_model_calls":100}
