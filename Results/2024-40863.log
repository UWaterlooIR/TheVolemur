{"actor":"server","event":"response","topic_id":"2024-40863","model_call":28,"request":{"op":"query","query":"(^ \"allergy shots\" \"bee sting\" \"quality of life\")"},"record":{"query":{"op":"query","query":"(^ \"allergy shots\" \"bee sting\" \"quality of life\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_56_1391180600#12_2762248206","ok":true,"op":"query","qid":"q1062","rank":1,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_56_1391180600#12_2762248206\" , \"end_char\": 9973.000000 , \"headings\": \"Overview of Bee Sting Reactions and Allergies Overview of <cover>Bee Sting Reactions and Allergies Overview Risk Factors Signs and Symptoms Insects That Cause Venom Allergies Honeybees Africanized (Killer) Honeybees Bumblebees Yellow Jackets Hornets Wasps Prevention Testing Who Should be Tested Immediate Treatment of Acute Reactions Treatment of Future Reactions After Allergy Shots for Bee Allergy The Bottom Line \" , \"segment\": \"This may be required in situations where stings are frequent and the swelling disrupts a person’s quality of life </cover>or ability to work. 3 ﻿ Testing is needed if a person of any age has symptoms of anaphylaxis after being stung. That's because the person has about a 30% to 60% chance that future insect stings will cause a similar reaction. 3 ﻿ Also, if there is a particular parental concern or the child is at high risk for frequent stings, venom testing and treatment is a reasonable option. People older than 16 with these same concerns should have venom testing and treatment, given ","skipped":[{"docno":"msmarco_v2.1_doc_56_1391180600#12_2762248206","rank":1,"relevance":3}]},"time":81},"model_calls":28,"document_judgments":20,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"request","topic_id":"2024-40863","model_call":28,"request":{"op":"next","qid":"q1062"},"model_calls":28,"document_judgments":20,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-40863","model_call":28,"request":{"op":"next","qid":"q1062"},"record":{"query":{"op":"next","qid":"q1062"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_56_1391180600#11_2762246097","ok":true,"op":"next","qid":"q1062","rank":2,"snippet":"not usually a reason to perform venom testing or to administer venom <cover>allergy shots. This is because the chance of developing anaphylaxis with future stings is only about 0% to 7% for both children and adults. 6 ﻿ A few studies show that these large local reactions can be decreased with the use of venom immunotherapy. This may be required in situations where stings are frequent and the swelling disrupts a person’s quality of life or ability to work. 3 ﻿ Testing is needed if a person of any age has symptoms of anaphylaxis after being stung. That's because the person has about a 30% to 60% chance that future insect stings will cause a similar reaction. 3 ﻿ Also, if there is a particular parental concern or the child is at high risk for frequent stings, venom testing and treatment is a reasonable option. People older than 16 with these same concerns should have venom testing and treatment, given a higher risk of anaphylaxis with future stings.\" , \"start_char\": 7926.000000 , \"title\": \"Overview of Bee Sting </cover>Reactions and Allergies\" , \"url\": \"https://www.","skipped":[{"docno":"msmarco_v2.1_doc_56_1391180600#11_2762246097","rank":2,"relevance":3}]},"time":6},"model_calls":28,"document_judgments":20,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
