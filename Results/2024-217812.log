{"actor":"server","event":"request","topic_id":"2024-217812","model_call":20,"request":{"op":"query","query":"(^ (+ \"palpebral fissure slant\" \"palpebral fissure inclination\" \"canthal tilt\") (+ \"lateral canthus\" \"medial canthus\") (+ genetics ethnic sex age anatomy))"},"model_calls":20,"document_judgments":14,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-217812","model_call":20,"request":{"op":"query","query":"(^ (+ \"palpebral fissure slant\" \"palpebral fissure inclination\" \"canthal tilt\") (+ \"lateral canthus\" \"medial canthus\") (+ genetics ethnic sex age anatomy))"},"record":{"query":{"op":"query","query":"(^ (+ \"palpebral fissure slant\" \"palpebral fissure inclination\" \"canthal tilt\") (+ \"lateral canthus\" \"medial canthus\") (+ genetics ethnic sex age anatomy))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_23_1397690825#5_3080888894","ok":true,"op":"query","qid":"q2543","rank":1,"snippet":"Mewing Blepharoplasty (Eyelid Lift) Canthoplasty & Canthopexy Eyebrows \" , \"segment\": \"Canthal Tilt The canthus is the pink part of your eye. The medial canthus is by your nose, and the lateral canthus is on the outside of your face. Canthal tilt is the angle between your medial and lateral canthus. If your lateral canthus is higher than your medial canthus, you have a positive canthal tilt. You have a neutral tilt when the canthi are aligned. But if your lateral canthus is lower than your medial canthus, you have negative canthal tilt. The normal male Caucasian medial canthus is about 2 mm lower than the lateral canthus (positive canthal tilt). Women have an even more positive canthal tilt, and their medial canthus is 4 mm lower than the <cover>lateral canthus. A positive canthal tilt is also known as a Mongoloid feature. Indeed, far eastern ethnic </cover>groups have a more positive tilt.\" , \"start_char\": 2097.000000 , \"title\": \"How to Get Attractive Eyes for Guys – Magnum Workshop\" , \"url\": \"https://magnumworkshop.com/how-to-get-attractive-eyes-for-guys/\" }","skipped":[{"docno":"msmarco_v2.1_doc_23_1397690825#5_3080888894","rank":1,"relevance":2}]},"time":97},"model_calls":20,"document_judgments":14,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
