{"actor":"server","event":"request","topic_id":"2024-217812","model_call":28,"request":{"op":"next","qid":"q2551"},"model_calls":28,"document_judgments":19,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-217812","model_call":28,"request":{"op":"next","qid":"q2551"},"record":{"query":{"op":"next","qid":"q2551"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_23_1397690825#5_3080888894","ok":true,"op":"next","qid":"q2551","rank":2,"snippet":"Mewing Blepharoplasty (Eyelid Lift) Canthoplasty & Canthopexy Eyebrows \" , \"segment\": \"Canthal Tilt The canthus is the pink part of your eye. The medial canthus is by your nose, and the lateral canthus is on the outside of your face. Canthal tilt is the angle between your medial and lateral canthus. If your lateral canthus is higher than your medial canthus, you have a positive canthal tilt. You have a neutral tilt when the canthi are aligned. But if your lateral canthus is lower than your medial canthus, you have negative canthal tilt. The normal male Caucasian medial canthus is about 2 <cover>mm lower than the lateral canthus (positive canthal tilt). Women </cover>have an even more positive canthal tilt, and their medial canthus is 4 mm lower than the lateral canthus. A positive canthal tilt is also known as a Mongoloid feature. Indeed, far eastern ethnic groups have a more positive tilt.\" , \"start_char\": 2097.000000 , \"title\": \"How to Get Attractive Eyes for Guys – Magnum Workshop\" , \"url\": \"https://magnumworkshop.com/how-to-get-attractive-eyes-for-guys/\" }","skipped":[{"docno":"msmarco_v2.1_doc_23_1397690825#5_3080888894","rank":2,"relevance":2}]},"time":5},"model_calls":28,"document_judgments":19,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
