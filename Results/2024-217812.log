{"actor":"server","event":"response","topic_id":"2024-217812","model_call":20,"request":{"op":"next","qid":"q2543"},"record":{"query":{"op":"next","qid":"q2543"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_23_1397690825#6_3080890346","ok":true,"op":"next","qid":"q2543","rank":2,"snippet":"Tilt Downturned Medial Canthus Arch Shape Eyebrows Scleral Show Color Limbal Ring Overall Dimensions Unattractive Male Eyes Attractive Male Eyes How To Get Nice Eyes Mewing Blepharoplasty (Eyelid Lift) Canthoplasty & Canthopexy Eyebrows \" , \"segment\": \"But if your lateral canthus is lower than your medial canthus, you have negative canthal tilt. The normal male Caucasian medial canthus is about 2 mm lower than the lateral canthus (positive canthal tilt). Women have an even more positive canthal tilt, and their medial canthus is 4 mm lower than the <cover>lateral canthus. A positive canthal tilt is also known as a Mongoloid feature. Indeed, far eastern ethnic </cover>groups have a more positive tilt. Generally, a slightly positive canthal tilt is most attractive. A negative canthal tilt is unattractive and makes you look tired. A canthal tilt that’s too positive makes you look like an alien. Before you conclude that you have a negative canthal tilt, keep in mind that taking a selfie from below eye level will make your canthal tilt appear more negative. Take your photo at eye level or look in the mirror.\" , \"start_char\": 2459.000000 , \"","skipped":[{"docno":"msmarco_v2.1_doc_23_1397690825#6_3080890346","rank":2,"relevance":2}]},"time":5},"model_calls":20,"document_judgments":14,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
