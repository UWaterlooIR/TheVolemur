{"actor":"server","event":"response","topic_id":"2024-217812","model_call":17,"request":{"op":"query","query":"(^ \"positive canthal tilt\" (+ why causes caused due) (+ genetics anatomy ethnicity aging))"},"record":{"query":{"op":"query","query":"(^ \"positive canthal tilt\" (+ why causes caused due) (+ genetics anatomy ethnicity aging))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_48_1370231623#4_2504753484","ok":true,"op":"query","qid":"q2541","rank":1,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_48_1370231623#4_2504753484\" , \"end_char\": 2382.000000 , \"headings\": \"Canthal Tilt in Cosmetic Plastic Surgery Canthal Tilt in Cosmetic Plastic Surgery Types of Canthal Tilt How to Improve your Canthal Tilt Canthal Tilt Correction Canthoplasty<cover>Positive Canthal Tilt Neutral Canthal Tilt \" , \"segment\": \"Like aging itself, diminishing canthal tilt is multifactorial. But, there are a number of things that you can do to maintain your overall periorbatl appearance. Canthal Tilt Correction 1. Do not smoke. Smoking causes </cover>reduced elasticity in every tissue of your body including your lower eyelids. Loss of elasticity leads to laxity in the skin and the supporting structures of your eyelid. To help maintain canthal tilt and periorbital til, avoid smoking. 2. Use Sunscreen. Sun damage is another leading cause of elasticity loss in the soft tissue Always wear appropriate sunscreen.\" , \"start_char\": 1802.000000 , \"title\": \"Canthal Tilt | Cosmetic Surgery | Fort Lauderdale to Vero Beach, FL.\" , \"url\": \"https://www.oceandriveplasticsurgery.com/"},"time":50},"model_calls":17,"document_judgments":12,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
