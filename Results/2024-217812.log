{"actor":"server","event":"response","topic_id":"2024-217812","model_call":36,"request":{"op":"query","query":"(^ \"canthal tilt\" (+ inherited genetic hereditary ethnic) (+ positive negative natural))"},"record":{"query":{"op":"query","query":"(^ \"canthal tilt\" (+ inherited genetic hereditary ethnic) (+ positive negative natural))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_23_1397690825#6_3080890346","ok":true,"op":"query","qid":"q2558","rank":1,"snippet":"Unattractive Male Eyes Attractive Male Eyes How To Get Nice Eyes Mewing Blepharoplasty (Eyelid Lift) Canthoplasty & Canthopexy Eyebrows \" , \"segment\": \"But if your lateral canthus is lower than your medial canthus, you have negative canthal tilt. The normal male Caucasian medial canthus is about 2 mm lower than the lateral canthus (positive canthal tilt). Women have an even more positive canthal tilt, and their medial canthus is 4 mm lower than the lateral canthus. A positive canthal tilt is also known as a Mongoloid feature. Indeed, far eastern <cover>ethnic groups have a more positive tilt. Generally, a slightly positive canthal tilt </cover>is most attractive. A negative canthal tilt is unattractive and makes you look tired. A canthal tilt that’s too positive makes you look like an alien. Before you conclude that you have a negative canthal tilt, keep in mind that taking a selfie from below eye level will make your canthal tilt appear more negative. Take your photo at eye level or look in the mirror.\" , \"start_char\": 2459.000000 , \"title\": \"How to Get Attractive Eyes for Guys – Magnum Workshop\"","skipped":[{"docno":"msmarco_v2.1_doc_23_1397690825#6_3080890346","rank":1,"relevance":2}]},"time":40},"model_calls":36,"document_judgments":27,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"request","topic_id":"2024-217812","model_call":36,"request":{"op":"next","qid":"q2558"},"model_calls":36,"document_judgments":27,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-217812","model_call":36,"request":{"op":"next","qid":"q2558"},"record":{"query":{"op":"next","qid":"q2558"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_23_1397690825#5_3080888894","ok":true,"op":"next","qid":"q2558","rank":2,"snippet":"Mewing Blepharoplasty (Eyelid Lift) Canthoplasty & Canthopexy Eyebrows \" , \"segment\": \"Canthal Tilt The canthus is the pink part of your eye. The medial canthus is by your nose, and the lateral canthus is on the outside of your face. Canthal tilt is the angle between your medial and lateral canthus. If your lateral canthus is higher than your medial canthus, you have a positive canthal tilt. You have a neutral tilt when the canthi are aligned. But if your lateral canthus is lower than your medial canthus, you have negative canthal tilt. The normal male Caucasian medial canthus is about 2 mm lower than the lateral canthus (positive canthal tilt). Women have an even more positive canthal tilt, and their medial canthus is 4 mm lower than the lateral canthus. A <cover>positive canthal tilt is also known as a Mongoloid feature. Indeed, far eastern ethnic </cover>groups have a more positive tilt.\" , \"start_char\": 2097.000000 , \"title\": \"How to Get Attractive Eyes for Guys – Magnum Workshop\" , \"url\": \"https://magnumworkshop.com/how-to-get-attractive-eyes-for-guys/\" }","skipped":[{"docno":"msmarco_v2.1_doc_23_1397690825#5_3080888894","rank":2,"relevance":2}]},"time":5},"model_calls":36,"document_judgments":27,"relevance_3":0,"max_document_judgments":50,"max_model_calls":100}
