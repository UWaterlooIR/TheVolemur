{"actor":"server","event":"response","topic_id":"2024-217812","model_call":50,"request":{"op":"query","query":"(^ \"upturned eyes\" (+ cause causes genetics inherited ancestry anatomy))"},"record":{"query":{"op":"query","query":"(^ \"upturned eyes\" (+ cause causes genetics inherited ancestry anatomy))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_48_1201125285#4_2188387964","ok":true,"op":"query","qid":"q2567","rank":1,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_48_1201125285#4_2188387964\" , \"end_char\": 3174.000000 , \"headings\": \"How to Tell if You Have Deep-Set Eyes How to Tell if You Have Deep-Set Eyes Table of Contents What Are Deep-Set Eyes? How to Tell if You Have Deep-Set Eyes Medical Conditions That <cover>Cause Deep-Set Eyes Deep-Set Eyes Are Just One Eye Shape References \" , \"segment\": \"If the line is above your pupil, you have upturned eyes, </cover>and if the line is below your pupil, you have downturned eyes, both of which are considered basic eye shapes. Close one eye and look at the crease on the eyelid. Then, open your eye and determine if this crease is hidden underneath the upper part of the brow bone. If it is, your eyes are hooded, which is another basic eye shape. Look at the whites of your eyes in relation to your iris. If you have white showing above and below your iris, your eyes are round, and if you have eyelids covering the whites around the iris, "},"time":71},"model_calls":50,"document_judgments":40,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
