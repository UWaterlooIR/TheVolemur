{"actor":"server","event":"response","topic_id":"2024-44059","model_call":97,"request":{"op":"next","qid":"q1629"},"record":{"query":{"op":"next","qid":"q1629"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_40_1259303777#8_2693500043","ok":true,"op":"next","qid":"q1629","rank":6,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_40_1259303777#8_2693500043\" , \"end_char\": 5353.000000 , \"headings\": \"About Minerals & Crystals About Minerals & Crystals What Are Crystals? Minerals, Crystals or Rocks? How Do Inorganic Crystals Form? Mineral Classes Economics of Crystals and Minerals Terminology and Illustrations RELATED ARTICLES \" , \"segment\": \"This is a sedimentary rock formation that's part of <cover>Zabriskie Point, located within Death Valley, California. It's composed of sediments from Furnace Creek Lake which dried up </cover>roughly 5 million years ago. Millions of years of erosion have left the sediment layers exposed. Metamorphic Rock - Rock that occurred when existing sedimentary or igneous rock was exposed to pressures and in some cases temperature changes that altered their original mineralogy. Metamorphic rock known as \"granite gneiss\". Formed from metamorphosed granite. How Do Inorganic Crystals Form? Crystals can form from a variety of different processes, including: Evaporite Deposits - These are mineral formations that occur as a result of processes at the earth’s surface. Crystals form from solutions containing minerals that become concentrated by dehydration/evaporation of an aqueous solution.\" ,","skipped":[{"docno":"msmarco_v2.1_doc_40_1259303777#8_2693500043","rank":6,"relevance":2}]},"time":6},"model_calls":97,"document_judgments":37,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
