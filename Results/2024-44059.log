{"actor":"server","event":"request","topic_id":"2024-44059","model_call":86,"request":{"op":"query","query":"(^ \"furnace creek lake\" \"dried up\" \"death valley\")"},"model_calls":86,"document_judgments":32,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-44059","model_call":86,"request":{"op":"query","query":"(^ \"furnace creek lake\" \"dried up\" \"death valley\")"},"record":{"query":{"op":"query","query":"(^ \"furnace creek lake\" \"dried up\" \"death valley\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_01_1809342308#3_2668230960","ok":true,"op":"query","qid":"q1621","rank":1,"snippet":"\"Interesting facts about Death Valley Interesting facts about Death Valley\" , \"segment\": \"Over 80 species of birds have been spotted around the pond. Artist’s Palette is an area on the face of the Black Mountains noted for a variety of rock colors. These colors are caused by the oxidation of different metals. It is the most colorful area in Death Valley. Zabriskie Point is a part of the Amargosa Range located east of Death Valley, noted for its erosional landscape. It is composed of sediments from <cover>Furnace Creek Lake, which dried up 5 million years ago—long before Death Valley </cover>came into existence. The geologic history of Death Valley is extremely complex and involves different types of fault activity at various periods, in addition to crustal sinking and even some volcanic activity. Rock art and artifacts indicate a human presence dating back at least 9,000 years. Death Valley is home to the Timbisha tribe of Native Americans, formerly known as the Panamint Shoshone, who have inhabited the valley for at least the past millennium. The valley received its English name in 1849 during the California Gold Rush.\" , \"start_char","skipped":[{"docno":"msmarco_v2.1_doc_01_1809342308#3_2668230960","rank":1,"relevance":2}]},"time":61},"model_calls":86,"document_judgments":32,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
