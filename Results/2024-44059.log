{"actor":"server","event":"response","topic_id":"2024-44059","model_call":50,"request":{"op":"next","qid":"q1593"},"record":{"query":{"op":"next","qid":"q1593"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_16_2761353410#4_3053623023","ok":true,"op":"next","qid":"q1593","rank":5,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_16_2761353410#4_3053623023\" , \"end_char\": 4360.000000 , \"headings\": \"Carefree, Arizona Carefree, Arizona Contents<cover>History Features Geography and climate Education Demographics Notable residents References External links \" , \"segment\": \"The studio was used for the filming of Bob Hope 's last feature film, Cancel My Reservation, with Eva Marie Saint, Ralph Bellamy, and Forrest Tucker. Scenes were also shot in Carefree and at the studio for Michaelangelo Antonioni 's Zabriskie Point, </cover>on the back lot, where a mock-up of the Carefree mansion was built and then exploded. The studio was also used for Paul Newman 's scenes in Pocket Money, for Bill Cosby 's feature debut, Man and Boy, for which the western street was built, and for Bill and Ted's Excellent Adventure, again the western street. The short, silent feature Time River was shot on Stages 2 and 3 and extensively on the back lot and western street sets. Southwestern Studios was also used in television productions. In 1973–74, local resident Hugh Downs produced and hosted two pilot episodes for ","skipped":[{"docno":"msmarco_v2.1_doc_16_3475641403#5_3842830888","rank":1,"relevance":0},{"docno":"msmarco_v2.1_doc_16_3475641403#6_3842836239","rank":2,"relevance":0},{"docno":"msmarco_v2.1_doc_19_690527615#3_771752803","rank":3,"relevance":3},{"docno":"msmarco_v2.1_doc_19_690527615#2_771751099","rank":4,"relevance":3}]},"time":7},"model_calls":50,"document_judgments":19,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
