loyed parents are 2 to 3 times higher and substance abuse and mental ","skipped":[{"docno":"msmarco_v2.1_doc_51_1065794891#8_2188160896","rank":1,"relevance":3}]},"time":612},"model_calls":34,"document_judgments":29,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
