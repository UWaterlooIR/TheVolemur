{"actor":"server","event":"response","topic_id":"2024-73340","model_call":34,"request":{"op":"next","qid":"q802"},"record":{"query":{"op":"next","qid":"q802"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_36_1307679309#4_2701077367","ok":true,"op":"next","qid":"q802","rank":10,"snippet":"2002) All Information (Except Text) Shown Here: Passed House without amendment (10/24/2001) \" , \"segment\": \"This bill has the status Became Law Here are the steps for Status of Legislation: Introduced Array  (  [actionDate] => 2001-10-23  [displayText] => Introduced in House  [externalActionCode] => 1000  [description] => Introduced  [chamberOfAction] => House ) Passed House Array  (  [actionDate] => 2001-10-24  [displayText] => Passed/agreed to in House: On motion to suspend the rules and pass the bill Agreed to by the Yeas and Nays: ( 2/3 required): <cover>357 - 66 (Roll no. 398). ( text of measure as passed House: CR 10/23/2001 H7159-7196)  [externalActionCode] => 8000  [description] => Passed House  [chamberOfAction] => House ) Passed Senate Array  (  [actionDate] => 2001-10-25  [displayText] => Passed/agreed to in Senate: Passed Senate without amendment by Yea-Nay Vote. 98 - 1.\" , \"start_char\": 1228.000000 , \"title\": \"H.R.3162 - 107th Congress (2001-2002): Uniting and Strengthening America by Providing Appropriate Tools Required to Intercept and Obstruct Terrorism (USA PATRIOT ACT) </cover>Act of 2001 | Congress.gov | Library of Congress\" , \"url\": \"https://www.congress.gov/bill/107th-congress/house-bill/03162\" }","skipped":[{"docno":"msmarco_v2.1_doc_36_1307679309#4_2701077367","rank":10,"relevance":3}]},"time":6},"model_calls":34,"document_judgments":23,"relevance_3":16,"max_document_judgments":50,"max_model_calls":100}
