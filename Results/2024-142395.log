{"actor":"server","event":"request","topic_id":"2024-142395","model_call":51,"request":{"op":"next","qid":"q1029"},"model_calls":51,"document_judgments":34,"relevance_3":2,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-142395","model_call":51,"request":{"op":"next","qid":"q1029"},"record":{"query":{"op":"next","qid":"q1029"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_45_555980527#9_982776086","ok":true,"op":"next","qid":"q1029","rank":2,"snippet":"Choice Policies: States with legislation proposing Student Choice: Passing a Student Choice Policy: \" , \"segment\": \"Suggest reasonable alternatives such as writing a paper or preparing a chart. Put your request in writing. Make detailed notes and keep all correspondences relating to the matter. Ask your professor to please respond promptly to your request. If he does not do so, go to the principal, department head, or dean. Talk to other students and go to the professor or department head as a group to explain your objection to dissection. Create a <cover>petition against dissection in your school and ask other students </cover>to sign it. Give copies to the department head, principal, and anyone else you think could help. Ask your parent (s) or guardian (s) to write a letter in support of your decision. If the department head or dean is similarly unresponsive, contact the national Dissection Hotline at (800) 922-FROG or AnimaLearn at (800) 729-2287.\" , \"start_char\": 4739.000000 , \"title\": \"Last Chance for Animals - Dissection\" , \"url\": \"https://www.lcanimal.org/index.php/campaigns/other-issues/","skipped":[{"docno":"msmarco_v2.1_doc_45_555980527#10_982777753","rank":1,"relevance":2}]},"time":5},"model_calls":51,"document_judgments":34,"relevance_3":2,"max_document_judgments":50,"max_model_calls":100}
