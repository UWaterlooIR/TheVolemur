{"actor":"server","event":"response","topic_id":"2024-35620","model_call":9,"request":{"op":"next","qid":"q2128"},"record":{"query":{"op":"next","qid":"q2128"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_15_1309172021#1_2563357927","ok":true,"op":"next","qid":"q2128","rank":4,"snippet":"educator strives to spark motivation in all students in a way that spurs academic achievement and galvanizes success via motivational influence. As a teacher, have you been inspired to work harder or pursue a particular goal? Were you inspired to become an educator by one of your own great teachers? Inspiration can take many forms, from helping a pupil through the academic year and their short-term goals, to guiding them towards their <cover>future career. Years after graduation, many working professionals will still cite a particular teacher as the one who fostered their love of what they currently do and attribute their accomplishments to that educator. Inspiring teachers can be the thing of movies, like “Stand and Deliver” — the story of Jaime Escalante, a high school teacher who successfully inspired his dropout prone students </cover>to learn calculus. But great teachers are not born. One can learn to be an inspiring teacher.\" , \"start_char\": 689.000000 , \"title\": \"Be an Inspiring Teacher - Online Professional Development Courses for Teachers - Dominican CA Online\" , \"url\": \"https://dominicancaonline.com/coaching-life-lessons/be-an-inspiring-teacher/\" }","skipped":[{"docno":"msmarco_v2.1_doc_48_1039848851#7_1878652119","rank":1,"relevance":3},{"docno":"msmarco_v2.1_doc_48_1039848851#6_1878650944","rank":2,"relevance":3},{"docno":"msmarco_v2.1_doc_48_1039848851#14_1878661556","rank":3,"relevance":1}]},"time":7},"model_calls":9,"document_judgments":6,"relevance_3":2,"max_document_judgments":50,"max_model_calls":100}
