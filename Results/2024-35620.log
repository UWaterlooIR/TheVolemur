{"actor":"server","event":"response","topic_id":"2024-35620","model_call":78,"request":{"op":"next","qid":"q2187"},"record":{"query":{"op":"next","qid":"q2187"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_23_135588563#4_314717466","ok":true,"op":"next","qid":"q2187","rank":7,"snippet":": 2957.000000 , \"headings\": \"5 Famous Latinos: Role Models for Hispanic Heritage Month 5 Famous Latinos: Role Models for Hispanic Heritage Month 5 Famous Latinos for Kids 1. Ellen Ochoa: Astronaut 2. Jaime Escalante: Teacher 3. Pat Mora: Author 4. Mario Molina: Nobel Prize Winning Scientist 5. Roberto Clemente: Baseball Player & Humanitarian ___________________________________________________ MKB Hispanic Heritage Month Blog Hop: Participating Blogs. \" , \"segment\": \"When he immigrated to the US he taught himself English and went to <cover>college. Jaime Escalante is well known for teaching Calculus at an under-performing school in Los Angeles. He inspired and encouraged and motivated poor students </cover>at record numbers to take and pass the AP Calculus class, despite many cynics who didn’t believe in him. Read this kid-friendly biography of Jaime Escalante and check out this video where he is interviewed: YouTube thefutureschannel 328 subscribers Subscribe Jaime Escalante On Being A Teacher Watch later Copy link Info Shopping Tap to unmute If playback doesn't begin shortly, try restarting your device. More videos More videos You're signed out Videos you watch may be added to the TV's watch history and ","skipped":[{"docno":"msmarco_v2.1_doc_23_135588563#4_314717466","rank":7,"relevance":2}]},"time":6},"model_calls":78,"document_judgments":44,"relevance_3":10,"max_document_judgments":50,"max_model_calls":100}
