{"actor":"server","event":"response","topic_id":"2024-35620","model_call":77,"request":{"op":"next","qid":"q2187"},"record":{"query":{"op":"next","qid":"q2187"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_39_586753098#21_1198901672","ok":true,"op":"next","qid":"q2187","rank":5,"snippet":"\": \"msmarco_v2.1_doc_39_586753098#21_1198901672\" , \"end_char\": 10000.000000 , \"headings\": \"Escalante, Jaime: 1930—: Educator Escalante, Jaime: 1930—: Educator Jaime Escalante: 1930 —: Educator Early Teaching Experience At a Glance . . . Immigrated to the United States Challenged Students to Excel Became a National Hero Joined English for Children Initiative Sources Books Periodicals On-line Jaime Escalante<cover>Jaime Escalante Public Acclaim Program Continues Further Reading \" , \"segment\": \"All five took the Advanced Placement (AP) exam for calculus and four of them passed. This standardized test gave passing students college credits. It was so difficult that only two percent of American high school students even attempted it. Escalante was inspired </cover>by this success and worked even harder to recruit more students. He held special after-school sessions and Saturday classes to prepare students for the AP test. He also tutored those who were struggling during their\" , \"start_char\": 9521.000000 , \"title\": \"Jaime Escalante | Encyclopedia.com\" , \"url\": \"https://www.encyclopedia.com/people/social-sciences-and-","skipped":[{"docno":"msmarco_v2.1_doc_04_345449932#0_824515965","rank":1,"relevance":1},{"docno":"msmarco_v2.1_doc_04_345449932#1_824518445","rank":2,"relevance":1},{"docno":"msmarco_v2.1_doc_53_638824153#6_1349660670","rank":3,"relevance":1},{"docno":"msmarco_v2.1_doc_53_638824153#4_1349656986","rank":4,"relevance":3}]},"time":6},"model_calls":77,"document_judgments":43,"relevance_3":10,"max_document_judgments":50,"max_model_calls":100}
