{"actor":"server","event":"response","topic_id":"2024-129925","model_call":56,"request":{"op":"next","qid":"q1892"},"record":{"query":{"op":"next","qid":"q1892"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_17_1019268283#10_1122810805","ok":true,"op":"next","qid":"q1892","rank":4,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_17_1019268283#10_1122810805\" , \"end_char\": 9558.000000 , \"headings\": \"Gaius Marius<cover>Gaius Marius Contents Life Early career Subordinate to Metellus Run for the consulship War in Numidia Cimbri and Teutones As consul Reforms to the military</cover>Battle with the Germanic tribes Sixth consulship 90s BC Social War Sulla and the First Civil War Seventh consulship and death Legacy Reforms to the legions Assemblies and foreign affairs Political violence Timeline Consulships See also Notes References Books Articles Ancient sources External links \" , \"segment\": \"This loss was at least in part due to the enmity of the Metelli. In 116 BC he barely won election as praetor for the following year, coming in last, and was promptly accused of ambitus (electoral corruption). Being accused of electoral corruption was common during the middle and late Republic and details of the trial are sketchy or apocryphal. Marius, however, was able to win acquittal on this charge, and spent an uneventful year as praetor in Rome, likely as either praetor peregrinus or as president of the corruption court. "},"time":10},"model_calls":56,"document_judgments":42,"relevance_3":14,"max_document_judgments":50,"max_model_calls":100}
