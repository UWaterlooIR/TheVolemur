{"actor":"server","event":"response","topic_id":"2024-22886","model_call":53,"request":{"op":"next","qid":"q1382"},"record":{"query":{"op":"next","qid":"q1382"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_03_901758286#3_1512541939","ok":true,"op":"next","qid":"q1382","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_03_901758286#3_1512541939\" , \"end_char\": 4259.000000 , \"headings\": \"Emergency Medicaid in New York State - Limited <cover>Medicaid Coverage for Undocumented Immigrants Emergency </cover>Medicaid in New York State - Limited Medicaid Coverage for Undocumented Immigrants EMERGENCY MEDICAID Which Services are Covered as an Emergency? \" , \"segment\": \"See article for where to apply in NYC NYS directives are summarized below. In 2013, NYS eliminated the form physicians were previously required to fill out -- DOH-4471 form for the Certification of Treatment of an Emergency Medical Condition . ( revised in 2010) Immigrants need only submit the standard Medicaid application, and if they are found otherwise eligible, local districts are to issue a Client Benefit Identification Card and authorize coverage for a 12-month period, plus an additional 3-months if retroactive coverage is requested. For a claim to be paid, the physician must enter an emergency admission type in eMedNY. Standard spend down and renewal processes apply. NYS DOH GIS 13-MA-009 http://www.health.ny.gov/health_care/medicaid/publications/gis/13ma009.htm In January 2016, ","skipped":[{"docno":"msmarco_v2.1_doc_03_901758286#3_1512541939","rank":2,"relevance":3}]},"time":5},"model_calls":53,"document_judgments":47,"relevance_3":28,"max_document_judgments":50,"max_model_calls":100}
