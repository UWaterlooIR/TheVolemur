{"actor":"server","event":"response","topic_id":"2024-22886","model_call":44,"request":{"op":"query","query":"(^ (+ \"illegals get it all for free\" \"free health care\" \"free healthcare\") (+ factcheck \"fact check\" reuters politifact snopes) (+ undocumented \"illegal immigrants\"))"},"record":{"query":{"op":"query","query":"(^ (+ \"illegals get it all for free\" \"free health care\" \"free healthcare\") (+ factcheck \"fact check\" reuters politifact snopes) (+ undocumented \"illegal immigrants\"))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_51_479997533#5_985532663","ok":true,"op":"query","qid":"q1379","rank":1,"snippet":"supplemental insurance while ‘illegals get it all for free’ Partly false claim: Seniors must pay for Medicare and supplemental insurance while ‘illegals get it all for free’ VERDICT \" , \"segment\": \"These include legal restrictions, inability to afford private insurance, and not seeking other options due to fear of deportation ( here ). The KFF reports that 47% of undocumented immigrants are uninsured. The think tank Public Policy Institute of California (PPIC) says the number is 60% to 70%. Undocumented immigrants are excluded from government marketplaces like Medicare and ACA. Only emergency treatment is required to be administered to people regardless of their immigration status. VERDICT Partly false: Seniors on Social Security must pay for Medicare and supplemental insurance, but undocumented immigrants do not get the same health insurance coverage, or health care, for free Our Standards: The Thomson Reuters Trust Principles.\" , \"start_char\": 3207.000000 , \"title\": \"Partly false claim: Seniors must pay for Medicare and supplemental insurance while ‘<cover>illegals get it all for free’ | Reuters\" , \"url\": \"https://www.reuters.com/article/uk-factcheck-undocumented-</cover>free-healthcar-idUSKBN20Y3FD\" }"},"time":474},"model_calls":44,"document_judgments":39,"relevance_3":20,"max_document_judgments":50,"max_model_calls":100}
