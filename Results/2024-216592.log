{"actor":"server","event":"request","topic_id":"2024-216592","model_call":49,"request":{"op":"query","query":"(^ \"disability insurance\" \"financial safety net\" (+ income paycheck))"},"model_calls":49,"document_judgments":44,"relevance_3":33,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-216592","model_call":49,"request":{"op":"query","query":"(^ \"disability insurance\" \"financial safety net\" (+ income paycheck))"},"record":{"query":{"op":"query","query":"(^ \"disability insurance\" \"financial safety net\" (+ income paycheck))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_54_274979302#4_616832825","ok":true,"op":"query","qid":"q1191","rank":1,"snippet":"Safety Net Summary \" , \"segment\": \"If you saved 5% of your income each year, a 6-month disability would eat up 10 years of savings! Don't think it could happen to you? Although your chances of having a disability increase as you get older, illness and injury can happen at any age. Car accidents, sports injuries, back injuries, and disease are just a few examples. The likelihood of being disabled is far greater for most people than the likelihood of dying during a given period of time, yet millions of people carry life insurance (another important piece of your <cover>financial safety net), but not disability insurance. Consider disability insurance as insurance for your ability to generate income. </cover>Ask yourself this question: Could you and your family live without your income for three months? Hopefully, the answer is yes since you've built up that emergency fund. But what about six months?\" , \"start_char\": 3771.000000 , \"title\": \"How to Build a Healthy Financial Safety Net\" , \"url\": \"https://www.thebalance.com/build-financial-safety-net-1289301\" }"},"time":96},"model_calls":49,"document_judgments":44,"relevance_3":33,"max_document_judgments":50,"max_model_calls":100}
