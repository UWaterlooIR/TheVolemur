{"actor":"server","event":"request","topic_id":"2024-41918","model_call":33,"request":{"op":"next","qid":"q975"},"model_calls":33,"document_judgments":29,"relevance_3":18,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-41918","model_call":33,"request":{"op":"next","qid":"q975"},"record":{"query":{"op":"next","qid":"q975"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_47_798058821#11_1716771796","ok":true,"op":"next","qid":"q975","rank":2,"snippet":"\" , \"segment\": \"They are used to provide thermoelectric cooling however the efficiencies of Peltier effect devices are typically around 5% to 10%, much less than the 40% to 50% achievable with compressor based refrigeration units which limits their use to small portable refrigerators and cooling plates. Seebeck effect thermopiles are used to convert heat energy into electrical energy in thermoelectric generators (TEGs) with electrical power outputs of 1000 Watts or more. TEGs have been used for some time in Radioisotope Thermoelectric Generators (RTGs) to provide portable power in <cover>spacecraft applications using the heat from the decay of radioactive isotopes such as Plutonium </cover>238. See Nuclear Batteries . More recently the possibility of using thermocouple arrays in automotive applications to recover waste heat from engine exhaust gases is being investigated. With an exhaust gas temperature of 250°C and a coolant temperature of 50°C, power outputs of over 300 Watts have been achieved but this drops to 150 Watts when the coolant temperature increases to 90° C See also Direct Conversion of Heat Energy to Electrical Energy (2) the AMTEC Thermal Battery Return to Electrical Energy Overview\" , \"start_char\"","skipped":[{"docno":"msmarco_v2.1_doc_18_1152658657#0_1303710121","rank":1,"relevance":3}]},"time":10},"model_calls":33,"document_judgments":29,"relevance_3":18,"max_document_judgments":50,"max_model_calls":100}
