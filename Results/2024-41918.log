{"actor":"server","event":"response","topic_id":"2024-41918","model_call":19,"request":{"op":"query","query":"(^ plutonium 238 (+ pacemaker pacemakers) (+ nuclear atomic battery batteries))"},"record":{"query":{"op":"query","query":"(^ plutonium 238 (+ pacemaker pacemakers) (+ nuclear atomic battery batteries))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_27_1245654658#3_2504437366","ok":true,"op":"query","qid":"q969","rank":1,"snippet":"Buoys Oil Well Equipment Seismic and Oceanographic Devices \" , \"segment\": \"Smoke particles disrupt this current, triggering an alarm. Spacecraft Power Radioisotope thermoelectric generators are used to power a wide array of satellites and spacecraft, including Pioneer 10 and 11 and Voyager 1 and 2. These devices function like a battery, with the benefit of a long life span. Plutonium-238 serves as the fuel source, producing alpha radiation resulting in heat, which is converted to electricity. Pacemaker Battery Alpha radiation is used as an energy source to power heart <cover>pacemakers. Plutonium-238 is used as the fuel source for such batteries; </cover>with a half-life of 88 years, this source of power provides a long lifespan for pacemakers. However, due to their toxicity, difficulties with patients in traveling, and problems with disposal, they are no longer used. Remote Sensing Stations The Unites States Air Force uses alpha radiation to power remote sensing stations in Alaska. Strontium-90 is typically used as the fuel source.\" , \"start_char\": 1845.000000 , \"title\": \"10 Uses of Alpha Radiation | Sciencing\" , \"url\": \"https://","skipped":[{"docno":"msmarco_v2.1_doc_27_1245654658#3_2504437366","rank":1,"relevance":2}]},"time":218},"model_calls":19,"document_judgments":16,"relevance_3":11,"max_document_judgments":50,"max_model_calls":100}
