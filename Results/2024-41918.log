{"actor":"server","event":"response","topic_id":"2024-41918","model_call":5,"request":{"op":"next","qid":"q963"},"record":{"query":{"op":"next","qid":"q963"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_26_167962818#1_350341527","ok":true,"op":"next","qid":"q963","rank":3,"snippet":"1_350341527\" , \"end_char\": 2039.000000 , \"headings\": \"Plutonium-238 to help power Perseverance on Mars Plutonium-238 to help power Perseverance on Mars Explore further \" , \"segment\": \"This accomplishment represents countless hours of work by dedicated ORNL staff, and it's rewarding to see this work come to fruition. Helping NASA in its mission to Mars is a significant moment in the history of the lab.\\\" Like other rovers on deep-<cover>space missions, Perseverance's traveling power on Mars comes from thermoelectric generators that create electricity from heat generated from the decay of plutonium-238 </cover>in the form of oxide ceramic pellets. Pu-238 produces heat as it decays, and the rover's multi-mission radioisotope thermoelectric generator converts that heat into electricity to charge the lithium-ion batteries that move the rover and power the instruments it will use on the surface of the Red Planet. Pu-238 is ideal for deep-space travel because of its long half-life of nearly 88 years, but it has been in short supply. Previously, the U.S. stockpile consisted primarily of Pu-238 produced "},"time":15},"model_calls":5,"document_judgments":3,"relevance_3":2,"max_document_judgments":50,"max_model_calls":100}
