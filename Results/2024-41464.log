{"actor":"server","event":"response","topic_id":"2024-41464","model_call":21,"request":{"op":"next","qid":"q3089"},"record":{"query":{"op":"next","qid":"q3089"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_43_1482386449#6_3134435952","ok":true,"op":"next","qid":"q3089","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_43_1482386449#6_3134435952\" , \"end_char\": 4696.000000 , \"headings\": \"Values-Based Leadership: Traits and Benefits Values-Based Leadership: Traits and Benefits What is values-based leadership? What does values-based leadership do? Setting direction Creating proactive company culture Improving individuals Expanding opportunities Key traits of a values-based leader Self-reflection Self-confidence<cover>Humility Positive influence Benefits of values-based leadership Improved communication Stronger relationships</cover>Increased productivity Helps in achieving goals Improved decision-making \" , \"segment\": \"Humility Good leaders understand who they are and where they came from. Humility for leaders is the belief that they are no different than the people who work for them. These leaders believe that every employee holds just as much value to the company as they do. Humble leaders do what it takes to lift up their teams and ensure they are well taken care of for their work. Positive influence By exemplifying the company's core values in their work, values-based leaders support their teams by serving them and ensuring they receive the best benefits ","skipped":[{"docno":"msmarco_v2.1_doc_49_1608274146#6_3374374297","rank":1,"relevance":2}]},"time":9},"model_calls":21,"document_judgments":19,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
