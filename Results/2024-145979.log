{"actor":"server","event":"response","topic_id":"2024-145979","model_call":44,"request":{"op":"next","qid":"q1030"},"record":{"query":{"op":"next","qid":"q1030"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_25_403737815#10_800798478","ok":true,"op":"next","qid":"q1030","rank":5,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_25_403737815#10_800798478\" , \"end_char\": 6870.000000 , \"headings\": \"How Nurses Can Combat Compassion Fatigue How Nurses Can Combat Compassion Fatigue<cover>Signs of Compassion Fatigue Ways to Prevent and Deal With Compassion Fatigue 1. Set a schedule that works for you 2. Make time for yourself 3. Create a support system 4. Make work an enjoyable place 5. Move around to new positions Additional Resources for Nurses Our Contributors Are you ready to earn your online nursing degree? \" , \"segment\": \"RN.com Along with online continuing education opportunities, this website offers tips and tricks for dealing with compassion fatigue and helping co-workers who may also be suffering. Unrestrained Podcast Featuring psychiatry nurse Laurie Barkin, this free podcast episode details strategies for coping with vicarious trauma </cover>and compassion fatigue. Barkin draws on her extensive experience to provide support. Our Contributors Jackie Murphy, EdD, RN, CPN, CNE completed her undergraduate studies at Gwynedd-Mercy University and Thomas Jefferson University. She earned an MSN in nursing education and faculty role and an EdD in educational ","skipped":[{"docno":"msmarco_v2.1_doc_25_403737815#10_800798478","rank":5,"relevance":2}]},"time":7},"model_calls":44,"document_judgments":40,"relevance_3":23,"max_document_judgments":50,"max_model_calls":100}
