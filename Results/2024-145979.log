{"actor":"server","event":"response","topic_id":"2024-145979","model_call":46,"request":{"op":"next","qid":"q1032"},"record":{"query":{"op":"next","qid":"q1032"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_54_1467297918#4_3111565923","ok":true,"op":"next","qid":"q1032","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_54_1467297918#4_3111565923\" , \"end_char\": 4706.000000 , \"headings\": \"Vicarious trauma & burnout Vicarious trauma & burnout Impacts of responding to family violence Recognising the signs and symptoms of <cover>vicarious trauma Recognising the signs and symptoms of burnout How to protect yourself Preventing burnout \" , \"segment\": \"Reach out to someone. This could be your manager, a trusted friend or colleague, a counsellor or another support </cover>person. You could also access your employee assistance program (EAP), if you have one. For after-hours support, the 1800RESPECT telephone and online counselling services are available 24 hours a day for professionals to discuss the personal impact of working with people who have experienced violence. Find a way to escape physically and/or mentally e.g. reading, days off, holidays. walks, seeing friends Rest – have some time with no goals e.g. taking naps, watching clouds, lying on the beach Play – have fun and do things that make you laugh e.g. playing with children and pets, creative activities, watching a favourite comedy A note on self-compassion: If ","skipped":[{"docno":"msmarco_v2.1_doc_54_1467297918#2_3111560698","rank":1,"relevance":3}]},"time":1},"model_calls":46,"document_judgments":41,"relevance_3":23,"max_document_judgments":50,"max_model_calls":100}
