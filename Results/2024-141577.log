{"actor":"server","event":"response","topic_id":"2024-141577","model_call":69,"request":{"op":"query","query":"(^ \"public menace\" \"leave his house\" carl)"},"record":{"query":{"op":"query","query":"(^ \"public menace\" \"leave his house\" carl)"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_15_627506019#1_1269328413","ok":true,"op":"query","qid":"q1834","rank":1,"snippet":"Dislikes Contents Background Physical Appearance Appearances Up \" , \"segment\": \"Carl impulsively tries to shove the worker with his walking cane but instead hits him, giving him a bloody injury on his forehead. Everyone stops, including the cars, and almost everyone comes to Steve. Carl is shocked for what he did, and hides in his house with his detached mailbox. When he peeks out of the window, the boss of the construction site is looking at him. Carl soon goes to court, and is thereafter deemed a \\\"<cover>public menace\" for assault. This incident is used to put pressure on Carl and make him leave his house. </cover>However, Carl leaves with his house anyways. This page uses Creative Commons Licensed content from the Pixar Wiki. The list of authors can be seen in the page revision history ( view authors ). As with Disney Wiki, the text of the Pixar Wiki is available under the CC-BY-SA license.\" , \"start_char\": 1009.000000 , \"title\": \"Construction Worker Steve | Disney Wiki | Fandom\" , \"url\": \"https://disney.fandom.com/wiki/Construction_Worker_Steve\" }","skipped":[{"docno":"msmarco_v2.1_doc_15_627506019#1_1269328413","rank":1,"relevance":2}]},"time":165},"model_calls":69,"document_judgments":28,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
