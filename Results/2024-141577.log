{"actor":"server","event":"response","topic_id":"2024-141577","model_call":93,"request":{"op":"next","qid":"q1852"},"record":{"query":{"op":"next","qid":"q1852"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_15_624182566#4_1265307744","ok":true,"op":"next","qid":"q1852","rank":7,"snippet":"Partner (s) Pets Background Development Personality Appearances Up Dug's Special Mission George and A.J. Disney Parks Relationships Gallery Trivia References External links Languages: \" , \"segment\": \"As the years passed, the city grew around Carl's old house with construction as he refused to move. After confronting a <cover>construction worker over his broken mailbox, the court orders Carl to move into the Shady Oaks Retirement Home. Carl comes up with a scheme to keep his promise to Ellie: he uses his old professional supplies to create a makeshift airship, using 10,000 helium balloons, which lifts his house off its foundations. Russell, a young Wilderness Explorer (a fictional scouting organization), becomes an accidental passenger in an effort to earn his final merit badge for assisting the elderly. After surviving a thunderstorm, the house lands near a ravine facing Paradise Falls. </cover>Carl and Russell harness themselves to the still-buoyant house and begin to walk it around the ravine, hoping to reach the falls before the balloons deflate. They later befriend a tall, colorful flightless bird whom Russell names \" Kevin \" who is trying to reach her chicks and a dog named Dug, who wears a ","skipped":[{"docno":"msmarco_v2.1_doc_15_624182566#4_1265307744","rank":7,"relevance":3}]},"time":4},"model_calls":93,"document_judgments":36,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
