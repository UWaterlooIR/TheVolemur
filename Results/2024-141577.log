{"actor":"server","event":"response","topic_id":"2024-141577","model_call":15,"request":{"op":"next","qid":"q1801"},"record":{"query":{"op":"next","qid":"q1801"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_26_239717669#3_510328608","ok":true,"op":"next","qid":"q1801","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_26_239717669#3_510328608\" , \"end_char\": 3849.000000 , \"headings\": \"Carl Fredricksen Carl Fredricksen<cover>Carl Fredricksen Series information Appearance Portrayed by Dug's Special Mission George and A.J. Personality Biography Early life Current life After travel Design Quotes Trivia Gallery References Languages: \" , \"segment\": \"Just as Carl and Ellie finally seemed to be able to make their trip, Ellie contracted an illness and passed away. Carl became bitter living in the house on his own as he missed his wife terribly. As the years passed, urban growth surrounded Carl's old house, which he refused to sell to developers. After striking a construction worker with his cane over the accidental damaging of his mailbox, the court labeled Carl as a public menace and ordered him to move into Shady Oaks Retirement </cover>Home. Carl came up with a scheme to keep his promise to Ellie and used what is presumably surplus supply from his professional career days to inflate 10,000 helium balloons to lift his home from its foundation and into the air. ","skipped":[{"docno":"msmarco_v2.1_doc_26_239717669#3_510328608","rank":2,"relevance":3}]},"time":6},"model_calls":15,"document_judgments":8,"relevance_3":6,"max_document_judgments":50,"max_model_calls":100}
