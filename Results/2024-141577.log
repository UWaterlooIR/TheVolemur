{"actor":"server","event":"response","topic_id":"2024-141577","model_call":48,"request":{"op":"next","qid":"q1818"},"record":{"query":{"op":"next","qid":"q1818"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_26_242330051#6_515018908","ok":true,"op":"next","qid":"q1818","rank":3,"snippet":"by Story by Music by Cinematography by Editing by MPAA rating Release date Running time Budget Box office Full Credits Home Video Soundtrack Merchandise Contents Synopsis Plot Voice Cast Reception Box Office Results Awards Rating Attached short films Gallery Posters Character Images Concept Art Screenshots External links References Languages: \" , \"segment\": \"He then ends up in a tussle with a construction worker over his broken mailbox, and is forced by a court order to move into a <cover>retirement home. He then realizes this would be his last chance to fulfill that promise. The next morning, two nurses, A.J. and George, from the Shady Oaks Retirement Village come to pick up Carl. </cover>He comes out, but tells the workers that before he leaves, he wants to \"say one last goodbye to the old place.\" They oblige, and walk back towards the van. Suddenly, thousands and thousands of balloons appear from behind the house. The house is ripped from its foundation and carried into the sky. Passersby look in shock to see the flying house. Carl proceeds to extend shower curtains and blankets from the side of the house, as rudders. Just when he lies down ","skipped":[{"docno":"msmarco_v2.1_doc_26_242330051#6_515018908","rank":3,"relevance":3}]},"time":4},"model_calls":48,"document_judgments":24,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
