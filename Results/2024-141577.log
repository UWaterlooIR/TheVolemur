{"actor":"server","event":"response","topic_id":"2024-141577","model_call":24,"request":{"op":"next","qid":"q1802"},"record":{"query":{"op":"next","qid":"q1802"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_26_239717669#3_510328608","ok":true,"op":"next","qid":"q1802","rank":14,"snippet":"Special Mission George and A.J. Personality Biography Early life Current life After travel Design Quotes Trivia Gallery References Languages: \" , \"segment\": \"Just as Carl and Ellie finally seemed to be able to make their trip, Ellie contracted an illness and passed away. Carl became bitter living in the house on his own as he missed his wife terribly. As the years passed, urban growth surrounded Carl's old house, which he refused to sell to developers. After striking a <cover>construction worker with his cane over the accidental damaging of his mailbox, the court labeled Carl as a public menace and ordered him to move into Shady Oaks Retirement Home. </cover>Carl came up with a scheme to keep his promise to Ellie and used what is presumably surplus supply from his professional career days to inflate 10,000 helium balloons to lift his home from its foundation and into the air. Russell, a young Wilderness Explorer, became an accidental passenger in his effort to earn his final merit badge for assisting the elderly. After surviving a thunderstorm and drifting all the way to South America, the house landed on a plateau facing Paradise Falls. Carl ","skipped":[{"docno":"msmarco_v2.1_doc_26_239717669#3_510328608","rank":14,"relevance":3}]},"time":4},"model_calls":24,"document_judgments":16,"relevance_3":14,"max_document_judgments":50,"max_model_calls":100}
