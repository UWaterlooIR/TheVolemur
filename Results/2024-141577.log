{"actor":"server","event":"response","topic_id":"2024-141577","model_call":48,"request":{"op":"next","qid":"q1818"},"record":{"query":{"op":"next","qid":"q1818"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_26_239717669#2_510326733","ok":true,"op":"next","qid":"q1818","rank":7,"snippet":"<cover>George and A.J. Personality Biography Early life Current life After travel Design Quotes Trivia Gallery References Languages: \" , \"segment\": \"In 1939, 9-year-old Carl Fredricksen was a shy, quiet boy who idolized renowned explorer Charles F. Muntz. One day, Carl befriended an adventurous girl named Ellie, who was also a Muntz fan. She confided to Carl her desire to move her \\\"clubhouse\\\"—an abandoned house in the neighborhood—to a cliff overlooking Paradise Falls, and made him promise to help her. Carl and Ellie eventually got married and grew old together in the restored house, working in a zoo as a balloon vendor, and as a zookeeper, respectively. Unable to have children, they repeatedly pooled their savings for a trip to Paradise Falls, but ended up spending it on more pressing needs. Just as Carl and Ellie finally seemed to be able to make their trip, Ellie contracted an illness and passed away. Carl became bitter living in the house on his own as he missed his wife terribly. As the years passed, urban growth surrounded Carl's old house, which he refused to sell to developers. After striking a construction worker with </cover>","skipped":[{"docno":"msmarco_v2.1_doc_26_239717669#2_510326733","rank":7,"relevance":3}]},"time":7},"model_calls":48,"document_judgments":24,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
