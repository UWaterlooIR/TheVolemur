{"actor":"server","event":"response","topic_id":"2024-141577","model_call":70,"request":{"op":"next","qid":"q1835"},"record":{"query":{"op":"next","qid":"q1835"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_15_624182566#4_1265307744","ok":true,"op":"next","qid":"q1835","rank":4,"snippet":"\": \"msmarco_v2.1_doc_15_624182566#4_1265307744\" , \"end_char\": 4992.000000 , \"headings\": \"Carl Fredricksen Carl Fredricksen Carl Fredricksen Background information Feature films Short films Television programs Video games Park attractions Animators Voice Inspiration Character information Full name Other names Occupation Home Likes Dislikes Partner (s) Pets Background Development Personality Appearances Up Dug's Special Mission<cover>George and A.J. Disney Parks Relationships Gallery Trivia References External links Languages: \" , \"segment\": \"As the years passed, the city grew around Carl's old house with construction as he refused to move. After confronting a construction worker over his broken mailbox, the court orders Carl to move into the Shady Oaks </cover>Retirement Home. Carl comes up with a scheme to keep his promise to Ellie: he uses his old professional supplies to create a makeshift airship, using 10,000 helium balloons, which lifts his house off its foundations. Russell, a young Wilderness Explorer (a fictional scouting organization), becomes an accidental passenger in an effort to earn his final merit badge for assisting the elderly. After surviving a thunderstorm, the house lands near ","skipped":[{"docno":"msmarco_v2.1_doc_15_624182566#4_1265307744","rank":4,"relevance":3}]},"time":7},"model_calls":70,"document_judgments":28,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
