{"actor":"server","event":"request","topic_id":"2024-141577","model_call":76,"request":{"op":"next","qid":"q1837"},"model_calls":76,"document_judgments":32,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-141577","model_call":76,"request":{"op":"next","qid":"q1837"},"record":{"query":{"op":"next","qid":"q1837"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_43_1255972390#3_2581769714","ok":true,"op":"next","qid":"q1837","rank":5,"snippet":"Summaries Spoilers Synopsis Contribute to This Page \" , \"segment\": \"When he meets Ellie, who also worships Muntz, they become close friends. However Charles Muntz falls into disgrace, accused of forging the skeleton of the monster of Paradise Falls. He travels in his blimp to South America to bring the monster back alive but is never seen again. Eventually Carl grows <cover>up and marries Ellie. They promise each other that they will travel together to Paradise Falls and build a house there. Many years later, Ellie dies and lonely Carl refuses to move from their home despite an offer from the owner of a construction company. When Carl accidentally hits a worker who damaged his mailbox, he is sentenced to move to a retirement home. However, he uses many balloons </cover>to float his house in order to travel to Paradise Falls. Adventure ensues. — Claudio Carvalho, Rio de Janeiro, Brazil Spoilers The synopsis below may give away important plot points.\" , \"start_char\": 1736.000000 , \"title\": \"Up (2009) - Plot Summary - IMDb\" , \"url\": \"https://www.imdb.com/title/tt1049413/plotsummary\"","skipped":[{"docno":"msmarco_v2.1_doc_43_1255972390#3_2581769714","rank":5,"relevance":3}]},"time":14},"model_calls":76,"document_judgments":32,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
