{"actor":"server","event":"response","topic_id":"2024-141577","model_call":93,"request":{"op":"next","qid":"q1852"},"record":{"query":{"op":"next","qid":"q1852"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_00_1484694643#6_2613415801","ok":true,"op":"next","qid":"q1852","rank":10,"snippet":"Gallery Videos Allusions External links Languages: \" , \"segment\": \"Carl then goes to buy tickets to <cover>Paradise Falls (presumably with retirement money). He then takes Ellie on a picnic, bringing the tickets as a surprise for her. While climbing up the hill where they had spent so much time before, Ellie's old age begins to catch up to her, and she stumbles over. Before long, she dies of old age in the hospital. Heartbroken and alone, Carl returns to his house after attending Ellie's funeral. In the present, Carl is old and grumpy. He still lives in his same old house, which he feels is the thing that's keeping Ellie close to him, but surrounding it is a huge city landscape; new buildings are coming up all around Carl's property. A corporation is trying to move him, which would break what he had promised. He then ends up in a tussle with a construction worker over his broken mailbox and is forced by a court order to move into a retirement home.</cover>\" , \"start_char\": 4743.000000 , \"title\": \"Up | Disney Wiki | ","skipped":[{"docno":"msmarco_v2.1_doc_00_1484694643#6_2613415801","rank":10,"relevance":3}]},"time":6},"model_calls":93,"document_judgments":36,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
