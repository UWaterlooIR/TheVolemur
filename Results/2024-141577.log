{"actor":"server","event":"response","topic_id":"2024-141577","model_call":70,"request":{"op":"next","qid":"q1835"},"record":{"query":{"op":"next","qid":"q1835"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_15_624182566#3_1265305627","ok":true,"op":"next","qid":"q1835","rank":6,"snippet":"s Special Mission<cover>George and A.J. Disney Parks Relationships Gallery Trivia References External links Languages: \" , \"segment\": \"One day, Carl befriended a tomboy named Ellie, who was also a Muntz fan. She confided to Carl her desire to move her \\\"clubhouse\\\" — an abandoned house in the neighborhood — to a cliff overlooking Paradise Falls and made him promise to help her. Carl and Ellie eventually got married and grew old together in the restored house, working in a zoo as a balloon vendor and a zookeeper, respectively. After being informed that Ellie was infertile, they repeatedly pooled their savings for a trip to Paradise Falls, but always ended up spending it on more pressing needs. Just as Carl and Ellie, who were both senior citizens, finally seemed able to take their trip, Ellie contracted an illness and died of old age, leaving Carl by himself, becoming bitter and cranky and missing his wife terribly. As the years passed, the city grew around Carl's old house with construction as he refused to move. After confronting a construction worker over his broken mailbox, the court orders Carl to move into the Shady Oaks </cover>Retirement Home. Carl ","skipped":[{"docno":"msmarco_v2.1_doc_15_624182566#3_1265305627","rank":6,"relevance":3}]},"time":7},"model_calls":70,"document_judgments":28,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"request","topic_id":"2024-141577","model_call":70,"request":{"op":"next","qid":"q1835"},"model_calls":70,"document_judgments":28,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-141577","model_call":70,"request":{"op":"next","qid":"q1835"},"record":{"query":{"op":"next","qid":"q1835"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_26_239717669#2_510326733","ok":true,"op":"next","qid":"q1835","rank":7,"snippet":"<cover>George and A.J. Personality Biography Early life Current life After travel Design Quotes Trivia Gallery References Languages: \" , \"segment\": \"In 1939, 9-year-old Carl Fredricksen was a shy, quiet boy who idolized renowned explorer Charles F. Muntz. One day, Carl befriended an adventurous girl named Ellie, who was also a Muntz fan. She confided to Carl her desire to move her \\\"clubhouse\\\"—an abandoned house in the neighborhood—to a cliff overlooking Paradise Falls, and made him promise to help her. Carl and Ellie eventually got married and grew old together in the restored house, working in a zoo as a balloon vendor, and as a zookeeper, respectively. Unable to have children, they repeatedly pooled their savings for a trip to Paradise Falls, but ended up spending it on more pressing needs. Just as Carl and Ellie finally seemed to be able to make their trip, Ellie contracted an illness and passed away. Carl became bitter living in the house on his own as he missed his wife terribly. As the years passed, urban growth surrounded Carl's old house, which he refused to sell to developers. After striking a construction worker with </cover>","skipped":[{"docno":"msmarco_v2.1_doc_26_239717669#2_510326733","rank":7,"relevance":3}]},"time":6},"model_calls":70,"document_judgments":28,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
