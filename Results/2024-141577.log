{"actor":"server","event":"response","topic_id":"2024-141577","model_call":74,"request":{"op":"next","qid":"q1837"},"record":{"query":{"op":"next","qid":"q1837"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_31_369552630#5_792749747","ok":true,"op":"next","qid":"q1837","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_31_369552630#5_792749747\" , \"end_char\": 3874.000000 , \"headings\": \"Up Dog Names Up Dog Names 0 Stories Introduction Up Dog Names in Pop Culture Featured Famous Up Dog Up Dog Name Considerations Male Up Dog Names Female Up Dog Names More articles by Pam Gueco Community Dogs With Up Names Share Your Dog's <cover>Up Name? \" , \"segment\": \"During one incident, Carl unintentionally harms a construction worker, which results in the court ordering that he be moved to a retirement home. But instead of moving, Carl attached thousands of balloons </cover>into his house to turn it into an airship. Russell, a young Boy Scout who visited Carl’s home to try and assist him and earn his final merit badge, was brought along with the house. This was the start of an adventure for Carl and Russell, who eventually make it to South America. Throughout their journey, they meet a pack of dogs who have special collars that allow them to speak. The pack brings the two to their master, who ends up ","skipped":[{"docno":"msmarco_v2.1_doc_31_369552630#5_792749747","rank":2,"relevance":3}]},"time":14},"model_calls":74,"document_judgments":30,"relevance_3":19,"max_document_judgments":50,"max_model_calls":100}
