{"actor":"server","event":"response","topic_id":"2024-224279","model_call":63,"request":{"op":"next","qid":"q579"},"record":{"query":{"op":"next","qid":"q579"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_29_989446240#4_2271502204","ok":true,"op":"next","qid":"q579","rank":2,"snippet":"1_doc_29_989446240#4_2271502204\" , \"end_char\": 3263.000000 , \"headings\": \" What are Student Learning Objectives? SLO Process 01 Why use Student Learning Objectives (SLOs) as a Measure of Student Growth? SLO Overview Resources Sample SLOs FAQs \" , \"segment\": \"Teachers and their appraisers will use SLOs to design strategies to meet their goals for student success, beginning with planning and leading to thoughtful instructional design and delivery. Throughout the year, teachers will collect evidence of <cover>student learning and adjust instruction accordingly. At the end of the cycle, teachers will reflect </cover>on outcomes and plan to refine their practice for the following year. SLO Overview Student Learning Objectives provide an effective process for improving instructional practices by encouraging thoughtful, deliberate, and evidence-based decisions that should ultimately result in improved student learning. Resources Check out the documents, videos and training modules. Sample SLOs Need to see some samples of SLOs that other teachers have created? FAQs Still have questions about SLOs? Visit our FAQs section.\" , \"start_char\": 2407.000000 , \"title\": \"Home - SLO"},"time":9},"model_calls":63,"document_judgments":48,"relevance_3":29,"max_document_judgments":50,"max_model_calls":100}
