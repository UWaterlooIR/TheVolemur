{"actor":"server","event":"response","topic_id":"2024-224279","model_call":18,"request":{"op":"next","qid":"q554"},"record":{"query":{"op":"next","qid":"q554"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_53_1160365489#11_2582754902","ok":true,"op":"next","qid":"q554","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_53_1160365489#11_2582754902\" , \"end_char\": 7104.000000 , \"headings\": \"Why Reflection Is Important In Teaching<cover>Why Reflection Is Important In Teaching Making Reflection Part Of Your Teaching Practice Reflection As A Strategy To Improve Social Equity Four Strategies For Reflective Teaching Build Community Create a cycle of reflection Choose a Purpose Use Open-Ended Probing Questions About The Author TeachThought Staff \" , \"segment\": \"Create a cycle of reflection Set aside a regular time and routine for teachers </cover>to reflect. In this routine, ask similar questions repeatedly over time, identify possible actions, and reflect on implementation. Choose a Purpose Reflection yields more concrete actions when the purpose is clear. Some purposes include building class culture, empowering students, increasing student learning and engagement, or identifying biases. Use Open-Ended Probing Questions Use questions that seek to learn more, to uncover underlying processes and values, and which encourage multiple possible perspectives or answers. Madhu Narayanan and Jill Ordynans are assistant professors at Relay Graduate School of Education. About The Author TeachThought Staff TeachThought is an organization ","skipped":[{"docno":"msmarco_v2.1_doc_53_1160365489#7_2582746970","rank":1,"relevance":3}]},"time":6},"model_calls":18,"document_judgments":14,"relevance_3":10,"max_document_judgments":50,"max_model_calls":100}
