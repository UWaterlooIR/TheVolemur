{"actor":"server","event":"response","topic_id":"2024-137182","model_call":10,"request":{"op":"next","qid":"q1991"},"record":{"query":{"op":"next","qid":"q1991"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_40_1107020185#2_2331558073","ok":true,"op":"next","qid":"q1991","rank":4,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_40_1107020185#2_2331558073\" , \"end_char\": 2673.000000 , \"headings\": \"The Dangers Of Phishing The Dangers Of Phishing Ricardo Villadiego How Did This Happen? Phishing Causes Permanent Damage To Brands \" , \"segment\": \"Fast-forward to Monday morning’s news headlines: Your company and your client have fallen victim to a massive phishing scheme. How Did This Happen? Phishing is all about the art of deception. Through <cover>social engineering, attackers take advantage human curiosity, fear and gullibility to manipulate their victims. </cover>In the case above, the hypothetical attacker took advantage of someone's fear of being compromised in order to actually compromise them. While phishing attacks have traditionally included emails spread across a wide group of organizations, spear phishing -- which targets a specific person or group of people -- has become more common. These targeted attacks are more efficient and sophisticated since they involve extensive planning and research about the victims. 2016 saw a 65% increase in phishing, with a total of 1,220,523 attacks for the year. This points to a much larger number "},"time":9},"model_calls":10,"document_judgments":7,"relevance_3":5,"max_document_judgments":50,"max_model_calls":100}
