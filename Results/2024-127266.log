{"actor":"server","event":"response","topic_id":"2024-127266","model_call":35,"request":{"op":"next","qid":"q1643"},"record":{"query":{"op":"next","qid":"q1643"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_08_255461441#2_492462717","ok":true,"op":"next","qid":"q1643","rank":3,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_08_255461441#2_492462717\" , \"end_char\": 3200.000000 , \"headings\": \"Solid Waste & Recycling Solid Waste & Recycling Solid Waste & Recycling Solid Waste & Recycling <cover>Collection Rose Hill Regional Transfer Station RHRTS Bag & Tag Program Licensed Commercial Hauler Options e-Waste Drop-off This includes: \" , \"segment\": \"By ordinance, all residents, whether they use the transfer station or contract with a commercial hauler, must separate recyclable materials from solid waste and recycle them. Residential and commercial hauler non-compliance may result in fines. Your cooperation and compliance with the solid waste and recycling ordinance is appreciated. The Town of Narragansett looks forward to continually sustaining a high recycling rate </cover>through the joint efforts of town staff, the commercial haulers and all residents. For additional information, questions or concerns please contact the Recycling Coordinator. Rose Hill Regional Transfer Station Rose Hill Regional Transfer Station, operated by the Town of South Kingstown, is located at 163 Rose Hill Road in South Kingstown one-half mile north of Saugatucket Road (783-4554). To encourage recycling, the Rose Hill Regional Transfer "},"time":9},"model_calls":35,"document_judgments":30,"relevance_3":15,"max_document_judgments":50,"max_model_calls":100}
