{"actor":"server","event":"response","topic_id":"2024-127266","model_call":13,"request":{"op":"next","qid":"q1630"},"record":{"query":{"op":"next","qid":"q1630"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_05_858871628#12_1343121600","ok":true,"op":"next","qid":"q1630","rank":2,"snippet":"Electronic Waste Option 1: Use a Manufacturer's Free and Convenient Takeback Program Option 2: Go to an Electronic Waste Collection Site Electronic Equipment Covered by the Act: Covered Electronic Equipment Does Not Include: Why Recycle Electronics? Manufacturers' Responsibilities to their Consumers: Frequently Asked Questions: \" , \"segment\": \"The NYS Electronic Equipment Recycling and Reuse Act requires manufacturers to provide free and convenient recycling of electronic waste to most consumers in the state. Collection opportunities include: fixed acceptance locations such as retail stores, sales outlets, not-for-profit organizations, or municipal facilities; mail or ship back return programs; collection events; and any combination of these or other acceptance methods which are reasonably convenient to consumers in the state. Manufacturers are not required to have a physical <cover>collection location in every community. If you have any problems trying to return electronic waste for recycling, </cover>please contact us at (518) 402-8706 or by e-mail. Frequently Asked Questions: Who qualifies as a consumer?\" , \"start_char\": 5274.000000 , \"title\": \"\" , \"url\": \"http://www.dec.ny.gov/chemical/66872.html\" }","skipped":[{"docno":"msmarco_v2.1_doc_19_410649178#0_444286982","rank":1,"relevance":1}]},"time":8},"model_calls":13,"document_judgments":11,"relevance_3":5,"max_document_judgments":50,"max_model_calls":100}
