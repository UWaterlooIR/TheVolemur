{"actor":"server","event":"response","topic_id":"2024-127266","model_call":40,"request":{"op":"next","qid":"q1645"},"record":{"query":{"op":"next","qid":"q1645"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_54_366667952#2_853194795","ok":true,"op":"next","qid":"q1645","rank":3,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_54_366667952#2_853194795\" , \"end_char\": 3028.000000 , \"headings\": \"Introduction to Electronics (E-Waste) Recycling Introduction to Electronics (E-Waste) Recycling Frequently Replaced Electronics What Happens to Devices at the End of Their Useful Life Benefits of E-Waste Recycling The Electronics Recycling Process Electronics Recycling Associations Current <cover>Challenges for Electronics Recycling Industry Electronics Recycling Laws Article Sources \" , \"segment\": \"3 Benefits of E-Waste Recycling Recycling e-waste enables us to recover various valuable metals </cover>and other materials from electronics, saving natural resources (energy), reducing pollution, conserving landfill space, and creating jobs. According to the EPA, recycling one million cell phones can also recover 75 pounds of gold, 772 pounds of silver, 35,000 pounds of copper, and 33 pounds of palladium. 4 On the other end, e-waste recycling helps cut down on production waste. According to the Electronics TakeBack Coalition, it takes 1.5 tons of water, 530 pounds of fossil fuel, and 40 pounds of chemicals to manufacture a single computer and monitor. Eighty one percent of the energy ","skipped":[{"docno":"msmarco_v2.1_doc_54_366667952#3_853196898","rank":2,"relevance":3}]},"time":1},"model_calls":40,"document_judgments":35,"relevance_3":16,"max_document_judgments":50,"max_model_calls":100}
