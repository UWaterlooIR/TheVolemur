{"actor":"server","event":"response","topic_id":"2024-153051","model_call":42,"request":{"op":"query","query":"(^ target shoplifters prosecute)"},"record":{"query":{"op":"query","query":"(^ target shoplifters prosecute)"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_54_370439816#2_862880913","ok":true,"op":"query","qid":"q1280","rank":1,"snippet":"1976.000000 , \"headings\": \"Shoplifting Policies and Procedures for Retailers Shoplifting Policies and Procedures for Retailers Stopping a Shoplifter Know the Law \" , \"segment\": \"Will you prosecute shoplifters under 18 or over 65? Is there a minimum qualifying dollar amount to prosecute? How will you confront and detain the shoplifter? What will you do if the shoplifter shows remorse or offers to pay? Who is responsible for calling the police? Consider a shoplifting policy that is fair but firm. If your store chooses not to <cover>prosecute shoplifters, word will get around, and your store may become a target. </cover>If shoplifters know your store takes theft seriously and is not afraid to prosecute, many thieves will avoid stealing from your business. Stopping a Shoplifter Store design, customer service techniques, and technology go a long way in preventing shoplifting . If your store prosecutes for shoplifting offenses, post signs stating as much.\" , \"start_char\": 1205.000000 , \"title\": \"Shoplifting Policies and Procedures for Retailers\" , \"url\": \"https://www.thebalancesmb.com/shoplifting-policies-and-procedures-2890262\" }"},"time":13},"model_calls":42,"document_judgments":21,"relevance_3":7,"max_document_judgments":50,"max_model_calls":100}
