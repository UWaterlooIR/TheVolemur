{"actor":"server","event":"response","topic_id":"2024-153051","model_call":71,"request":{"op":"next","qid":"q1248"},"record":{"query":{"op":"next","qid":"q1248"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_19_2021688056#5_3321153488","ok":true,"op":"next","qid":"q1248","rank":5,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_19_2021688056#5_3321153488\" , \"end_char\": 4186.000000 , \"headings\": \"Target Loss Prevention Policy: Fines, Legal Penalties, etc Target Loss Prevention Policy: Fines, Legal Penalties, etc Table of Contents Target Loss Prevention Policy General Target Loss Prevention <cover>Policy Suspect Apprehension Legal Penalties: Target Shoplifting </cover>Fines and More Other Store Shoplifting Policies \" , \"segment\": \"After apprehending a suspect, the loss prevention officers may take the suspect to their office to question them and await the arrival of police. Suspects are not required to speak to store officers. Target will have law enforcement proceed with an arrest if stolen merchandise is found on their person. Specific laws regarding apprehension and detention of larceny suspects may vary slightly by state. Legal Penalties: Target Shoplifting Fines and More Each state has guidelines that define a specific dollar amount as the criteria for determining whether a shoplifting offense is a misdemeanor or a felony. For example, New York law states that a theft totaling under $1,000 is classified as a misdemeanor. A theft over $1,000 qualifies as ","skipped":[{"docno":"msmarco_v2.1_doc_19_2021688056#5_3321153488","rank":5,"relevance":3}]},"time":1},"model_calls":71,"document_judgments":28,"relevance_3":7,"max_document_judgments":50,"max_model_calls":100}
