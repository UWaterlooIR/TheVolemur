{"actor":"server","event":"response","topic_id":"2024-153051","model_call":49,"request":{"op":"next","qid":"q1287"},"record":{"query":{"op":"next","qid":"q1287"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_19_2021688056#3_3321149932","ok":true,"op":"next","qid":"q1287","rank":4,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_19_2021688056#3_3321149932\" , \"end_char\": 3136.000000 , \"headings\": \"Target Loss Prevention Policy: Fines, Legal Penalties, etc Target Loss Prevention Policy: Fines, Legal Penalties, etc Table of Contents Target Loss Prevention Policy General Target Loss Prevention Policy Suspect Apprehension Legal Penalties: <cover>Target Shoplifting Fines </cover>and More Other Store Shoplifting Policies \" , \"segment\": \"Target shoplifting fines and fees for each individual incident will vary by state and degree of crime severity. Asset protection specialists at Target are responsible for keeping thorough documentation of each shoplifting incident at their store. They also work to identify shoplifting trends occurring within the store — such as whether shoplifters are targeting certain items — and to conduct internal theft investigations if necessary. Target’s security specialists are members of the asset protection team. They work at the front of the store and are trained in emergency response and how to handle a crisis to avoid escalating the situation. Some of their main job responsibilities include suspect apprehension assistance, merchandise recovery, and documentation of security issues. Suspect Apprehension Once a shopper ","skipped":[{"docno":"msmarco_v2.1_doc_19_2021688056#3_3321149932","rank":4,"relevance":3}]},"time":1},"model_calls":49,"document_judgments":24,"relevance_3":7,"max_document_judgments":50,"max_model_calls":100}
