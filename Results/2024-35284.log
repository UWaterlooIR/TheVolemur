{"actor":"server","event":"response","topic_id":"2024-35284","model_call":63,"request":{"op":"next","qid":"q1175"},"record":{"query":{"op":"next","qid":"q1175"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_08_604243814#3_1086718790","ok":true,"op":"next","qid":"q1175","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_08_604243814#3_1086718790\" , \"end_char\": 2598.000000 , \"headings\": \"The Flexner Report And Medical Education Education The Flexner Report And Medical Education Fund public radio's future \" , \"segment\": \"None of the above. <cover>Flexner was describing medical education in the United States and Canada. The report that he issued for the Carnegie Foundation published in 1910 led to the reform of medical schools. And in this centennial </cover>year of the Flexner report, we've invited Paul Starr, professor of sociology and public affairs at Princeton University, to talk about it. He's written extensively about the history of American medicine. Welcome to the program. Professor PAUL STARR (Sociology and Public Affairs, Princeton University): Good to be with you, Robert. SIEGEL: First, who was Abraham Flexner?\" , \"start_char\": 2001.000000 , \"title\": \"The Flexner Report And Medical Education : NPR\" , \"url\": \"http://www.npr.org/templates/story/story.php?storyId=122702668\" }","skipped":[{"docno":"msmarco_v2.1_doc_08_604243814#3_1086718790","rank":2,"relevance":3}]},"time":5},"model_calls":63,"document_judgments":36,"relevance_3":9,"max_document_judgments":50,"max_model_calls":100}
