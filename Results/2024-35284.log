{"actor":"server","event":"response","topic_id":"2024-35284","model_call":42,"request":{"op":"next","qid":"q1158"},"record":{"query":{"op":"next","qid":"q1158"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_08_604243814#14_1086730714","ok":true,"op":"next","qid":"q1158","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_08_604243814#14_1086730714\" , \"end_char\": 6560.000000 , \"headings\": \"The Flexner Report And Medical Education Education<cover>The Flexner Report And Medical Education Fund public radio's future \" , \"segment\": \"That was the vision. That was Flexner's idea that science had to be brought to the bedside. And his report played a very positive role in doing that. SIEGEL: Was the Carnegie Foundation </cover>so influential that a report from an educator who'd been sent around the country to look at medical schools could have that much influence on the way the country trained doctors? Prof. STARR: I think what you have to bear in mind is that at that time in 1910, American society was undergoing a revolution, in many different respects, as a result of science. The airplane had just been invented. The automobile was coming into use. The telephone was coming into use.\" , \"start_char\": 5909.000000 , \"title\": \"The Flexner Report And Medical Education : NPR\" , \"","skipped":[{"docno":"msmarco_v2.1_doc_08_604243814#3_1086718790","rank":1,"relevance":3}]},"time":6},"model_calls":42,"document_judgments":24,"relevance_3":5,"max_document_judgments":50,"max_model_calls":100}
