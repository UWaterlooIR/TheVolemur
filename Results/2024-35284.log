{"actor":"server","event":"response","topic_id":"2024-35284","model_call":41,"request":{"op":"query","query":"(^ \"flexner report\" \"history of american medicine\" \"carnegie foundation\")"},"record":{"query":{"op":"query","query":"(^ \"flexner report\" \"history of american medicine\" \"carnegie foundation\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_08_604243814#2_1086717573","ok":true,"op":"query","qid":"q1157","rank":1,"snippet":"Flexner Report And Medical Education Fund public radio's future \" , \"segment\": \"This is from Abraham Flexner's description of kind of American school that he reported on 100 years ago. The schools, he wrote, were essentially private ventures, money making in spirit and object. Income was simply divided among the lecturers. No applicant for instruction who could pay his fees or sign his note was turned down. Secretarial school or barber college or anyone-can-learn-to-draw art school? None of the above. Flexner was describing medical education in the United States and Canada. The report that he issued for the <cover>Carnegie Foundation published in 1910 led to the reform of medical schools. And in this centennial year of the Flexner report, we've invited Paul Starr, professor of sociology and public affairs at Princeton University, to talk about it. He's written extensively about the history of American medicine.</cover>\" , \"start_char\": 1592.000000 , \"title\": \"The Flexner Report And Medical Education : NPR\" , \"url\": \"http://www.npr.org/templates/story/story.php?storyId=122702668\" }","skipped":[{"docno":"msmarco_v2.1_doc_08_604243814#2_1086717573","rank":1,"relevance":3}]},"time":178},"model_calls":41,"document_judgments":24,"relevance_3":5,"max_document_judgments":50,"max_model_calls":100}
