{"actor":"server","event":"response","topic_id":"2024-27366","model_call":38,"request":{"op":"query","query":"(^ \"minimalism\" \"artists\" \"renouncing\" \"stale\" \"academic\")"},"record":{"query":{"op":"query","query":"(^ \"minimalism\" \"artists\" \"renouncing\" \"stale\" \"academic\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_09_1196858521#3_2099638835","ok":true,"op":"query","qid":"q2424","rank":1,"snippet":"Serra Do Not Miss Post-Minimalism Light and Space American Art Important Art and Artists of Minimalism Die Fahne Hoch! (1959) Die (1962) Lever (1966) Useful Resources on Minimalism Books Share \" , \"segment\": \"And I like using those different levels.\\\" 6 of 9 \\\"No to transcendence and spiritual values, heroic scale, anguished decisions, historicizing narrative, valuable artifact, intelligent structure, interesting visual experience.\\\" 7 of 9 \\\"The steel and the space, or the object and the void, become one and the same.\\\" 8 of 9 \\\"I like art as thought better than art as work. I've always maintained this. It's important to me that I don't get my hands dirty. It's not because I'm instinctively lazy. It's a declaration: art is thought.\\\" 9 of 9 Summary of Minimalism<cover>Minimalism emerged in New York in the early 1960s among artists who were self-consciously renouncing recent art they thought had become stale and academic.</cover>\" , \"start_char\": 1241.000000 , \"title\": \"Minimalism Movement Overview | TheArtStory\" , \"url\": \"http://www.theartstory.org/movement-minimalism.htm\" }","skipped":[{"docno":"msmarco_v2.1_doc_09_1196858521#3_2099638835","rank":1,"relevance":3}]},"time":68},"model_calls":38,"document_judgments":33,"relevance_3":10,"max_document_judgments":50,"max_model_calls":100}
