{"actor":"server","event":"response","topic_id":"2024-216957","model_call":32,"request":{"op":"next","qid":"q3291"},"record":{"query":{"op":"next","qid":"q3291"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_24_1528043899#0_3275666494","ok":true,"op":"next","qid":"q3291","rank":4,"snippet":"Blog \" , \"segment\": \"Managing Your Mental Health During the Holidays | NAMI: National Alliance on Mental Illness Home | Blogs | NAMI Blog | December 2017 | Managing Your Mental Health During the Holidays Managing Your Mental Health During the Holidays DEC. 19, 2017 By Colleen O’Day During the holiday season, many look forward to festivities with friends and family. But for others, this time can bring on or worsen stress, anxiety and depression. There are a variety of factors that can bring on holiday anxiety and <cover>depression. Some people experience increased financial burden due to travel, gift and/or hosting costs. Others may feel overwhelmed as the holiday season </cover>often includes a packed calendar of parties, performances and traveling that can be difficult to balance with everyday responsibilities and self-care. Not to mention: High expectations to give perfect gifts and plan perfect events, as well as loneliness for those who aren’t with loved ones. If you are experiencing any of these challenges, here are some coping tips you can use to manage your increased levels of anxiety, stress and sadness.\" , \"start_char\": 0.000000 , \"title\":"},"time":15},"model_calls":32,"document_judgments":27,"relevance_3":15,"max_document_judgments":50,"max_model_calls":100}
