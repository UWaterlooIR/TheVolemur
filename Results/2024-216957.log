{"actor":"server","event":"response","topic_id":"2024-216957","model_call":27,"request":{"op":"next","qid":"q3290"},"record":{"query":{"op":"next","qid":"q3290"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_46_788952568#1_1665436839","ok":true,"op":"next","qid":"q3290","rank":3,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_46_788952568#1_1665436839\" , \"end_char\": 2081.000000 , \"headings\": \"How to reduce Christmas stress How to reduce <cover>Christmas stress 1. Limit spending 2. Manage expectations</cover>Be realistic Help children to be realistic Take some time out 3. Avoid overindulging 4. Go for a walk 5. Have some fun \" , \"segment\": \"Most of us are aware of the adverse effects that stress can have on our body. It can impact our thoughts, feelings, and behaviors, and it can lead to high blood pressure, heart disease, diabetes, and obesity if left unchecked. In fact, research has shown that there is an increase in the occurrence of heart attacks and heart-related deaths during the festive season, which may be due to stress, heavy alcohol consumption, a fatty diet, or all three. Therefore, it is of utmost importance that holiday stress is dealt with — pronto. With all the cooking, decorating, visiting, and gift giving, the holidays can seem more like trying to meet a high-pressure deadline than a vacation. So, try these Christmas stress-busting "},"time":15},"model_calls":27,"document_judgments":22,"relevance_3":11,"max_document_judgments":50,"max_model_calls":100}
