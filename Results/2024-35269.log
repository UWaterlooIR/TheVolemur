{"actor":"server","event":"response","topic_id":"2024-35269","model_call":12,"request":{"op":"next","qid":"q1392"},"record":{"query":{"op":"next","qid":"q1392"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_19_1125498323#7_1591613303","ok":true,"op":"next","qid":"q1392","rank":2,"snippet":"of rebuilding the economy of European countries, was designed to improve the American economy and strengthen the U.S. position in Western Europe. Implementation of the plan allowed solving some of the economic problems of the United States. The provision of food and technologies to European countries allowed the United States to sell surplus products and increase the share of American capital in European countries. Approximately one third of the assistance funds were spent on the purchase of American agricultural products’ surplus. European markets guaranteed the safety of investments in U.S. companies, and the adequate compensation was provided in case of forfeiture. Proceeds from the sale of U.S. goods and services received under the <cover>Marshall Plan were credited to a special account in the name of American administration in the banks of the country and could be used only for the purchase of the U.S. goods.</cover>\" , \"start_char\": 4338.000000 , \"title\": \"The U.S. Economy Growth after World War II Essay Sample | EssaysLeader\" , \"url\": \"https://essaysleader.com/essays/the-u-s-economy-growth-after-world-war-ii/\" }","skipped":[{"docno":"msmarco_v2.1_doc_19_1125498323#8_1591615278","rank":1,"relevance":3}]},"time":6},"model_calls":12,"document_judgments":9,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
