{"actor":"server","event":"response","topic_id":"2024-35269","model_call":12,"request":{"op":"query","query":"(^ \"marshall plan\" (+ \"american exports\" \"u.s. exports\" \"american goods\" \"u.s. goods\") (+ purchase purchases dollars))"},"record":{"query":{"op":"query","query":"(^ \"marshall plan\" (+ \"american exports\" \"u.s. exports\" \"american goods\" \"u.s. goods\") (+ purchase purchases dollars))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_19_1125498323#8_1591615278","ok":true,"op":"query","qid":"q1392","rank":1,"snippet":"to sell surplus products and increase the share of American capital in European countries. Approximately one third of the assistance funds were spent on the purchase of American agricultural products’ surplus. European markets guaranteed the safety of investments in U.S. companies, and the adequate compensation was provided in case of forfeiture. Proceeds from the sale of U.S. goods and services received under the Marshall Plan were credited to a special account in the name of American administration in the banks of the country and could be used only for the <cover>purchase of the U.S. goods. This fact stimulated the U.S. exports. The Marshall Plan </cover>helped to strengthen the shaky position of Western Europe. The Marshall Plan prepared the conditions for the creation of NATO in accordance with the military and economic calculations of the United States. The Korean War The Korean War, which began in January 1950, had the stimulating effect on the U.S. economy. The law on production of weapons and military equipment, adopted in September of the same year, expanded the intervention of the federal government in the economy and social relations.\" , \"start_char\": 4975.000000","skipped":[{"docno":"msmarco_v2.1_doc_19_1125498323#8_1591615278","rank":1,"relevance":3}]},"time":516},"model_calls":12,"document_judgments":9,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
