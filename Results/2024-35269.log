{"actor":"server","event":"response","topic_id":"2024-35269","model_call":27,"request":{"op":"next","qid":"q1400"},"record":{"query":{"op":"next","qid":"q1400"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_06_655669197#1_1177976076","ok":true,"op":"next","qid":"q1400","rank":4,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_06_655669197#1_1177976076\" , \"end_char\": 1282.000000 , \"headings\": \"Truman Doctrine, Marshall Plan, Cominform and Comecon Monday, 30 September 2013 Truman Doctrine, Marshall Plan, Cominform and Comecon \" , \"segment\": \"He believed in  economic help to countries that were at a risk of becoming communist. Increase US <cover>exports when Europe recovered. It  was in response to the Truman Doctrine to organise Eastern European communist  governments. It  was set up in response to the Marshall Plan. </cover>It was a policy in which USSR financially supported Eastern  Europe. WHAT  IT WAS It  was a policy of containment that was aimed at stopping soviet expansion. The  Truman Doctrine announced the divide in the world Aid was given to all war torn countries that were at risk of becoming communist. Their agriculture and trade were recovered as a result of the Marshall Aid. They were given cash and technology. It  followed Soviet aims.\" , \"start_char\": 574.000000 , \"title\": \"gcse notes: Truman Doctrine, Marshall Plan, Cominform and "},"time":15},"model_calls":27,"document_judgments":22,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
