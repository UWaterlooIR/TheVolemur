{"actor":"server","event":"response","topic_id":"2024-224701","model_call":17,"request":{"op":"next","qid":"q3618"},"record":{"query":{"op":"next","qid":"q3618"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_39_795508142#14_1606540581","ok":true,"op":"next","qid":"q3618","rank":3,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_39_795508142#14_1606540581\" , \"end_char\": 6612.000000 , \"headings\": \"Rip Van Winkle Characters Rip Van Winkle Characters Characters Download Rip Van Winkle Study Guide Rip Van Winkle Dame Van Winkle Judith Cardenier<cover>Rip Van Winkle, Jr. The Stranger Hendrick (Henry) Hudson Nicholas Vedder Derrick Van Bummel Brom Dutcher Peter Vanderdonk The Self-Important Man Unlock This Study Guide Now \" , \"segment\": \"Rip often tries to escape her contentious nature by spending time with the men outside the inn. He also escapes her by going hunting and fishing. Dame Van Winkle is portrayed as a villain, </cover>deserving of blame. Yet, Dame Van Winkle is justified in her nagging, given that Rip won't work the farm or help with domestic matters. Rip leaves Dame Van Winkle alone to fend for the family. Dame Van Winkle is also called a “virago,” which is a domineering woman. However, the term “virago” may also refer to a warrior woman. This highlights how Dame Van Winkle fights throughout the story against her husband. She does so to help ","skipped":[{"docno":"msmarco_v2.1_doc_39_795508142#14_1606540581","rank":3,"relevance":3}]},"time":5},"model_calls":17,"document_judgments":11,"relevance_3":9,"max_document_judgments":50,"max_model_calls":100}
