{"actor":"server","event":"response","topic_id":"2024-217279","model_call":25,"request":{"op":"query","query":"(^ (+ \"military pay\" \"military compensation\") (+ myth underpaid \"low pay\") (+ benefits retirement allowances))"},"record":{"query":{"op":"query","query":"(^ (+ \"military pay\" \"military compensation\") (+ myth underpaid \"low pay\") (+ benefits retirement allowances))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_53_63017103#6_110330619","ok":true,"op":"query","qid":"q1649","rank":1,"snippet":"with the Ins and Outs of Military Life \" , \"segment\": \"Yes, I have civilian job-related events to be proud of him for, but I’m pretty sure there is nothing quite like the pride of watching your spouse get pinned … but I will never get to know for sure. Myth 4: When my husband goes to drill we get extra Reserve and Guard pay benefits. Truth: This might be the most common myth that I have to dispel for both my civilian and Active Duty friends. Benefits only change when my husband gets activated/deployed. That means regardless of whether he is at drill or serving his two weeks a year, our benefits never change. By the way, the <cover>military pay calculator is helpful for figuring out those benefits. Myth </cover>5: We have access to all the same help in times of need as our Active Duty friends.\" , \"start_char\": 2550.000000 , \"title\": \"9 Myths About Reservist Life | Military.com\" , \"url\": \"https://www.spousebuzz.com/blog/2012/08/9-myths-about-reservist-life.html\" }"},"time":345},"model_calls":25,"document_judgments":20,"relevance_3":7,"max_document_judgments":50,"max_model_calls":100}
