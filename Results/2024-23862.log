{"actor":"server","event":"response","topic_id":"2024-23862","model_call":43,"request":{"op":"next","qid":"q3254"},"record":{"query":{"op":"next","qid":"q3254"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_27_348866207#2_677699508","ok":true,"op":"next","qid":"q3254","rank":2,"snippet":"Tax Diversion Rates Background Figure 1: State Gas Tax Rates 2000-2019 Gas Tax Diversions by State Figure 2: State Gas Tax Diversion Rates Figure 3: Average Diversion Rate of Each U.S. Region Methodology Colorado Connecticut Florida Kansas Kentucky Louisiana Maine Maryland Massachusetts Michigan New Jersey (FY18) New York North Carolina North Dakota Oklahoma Pennsylvania Rhode Island South Carolina South Dakota Texas Utah Vermont Virginia Washington Wisconsin Analysis Recommendations \" , \"segment\": \"By violating the users-pay/users-benefit principle, <cover>diversion poses both immediate and long-term threats to transportation funding. Diversions can leave roads and highways underfunded. The 10 states diverting the largest percentage of their gas tax money: </cover>New York diverts 37.5% of its gas tax revenue, Rhode Island diverts 37.1%, New Jersey and Michigan divert 33.9%, Maryland diverts 32.5%, Connecticut diverts 27%, Texas diverts 24%, Massachusetts diverts 23.9%, Florida diverts 13.6% and Vermont diverts 13.2%. This policy brief catalogs state gas tax diversions of the 25 states that employ that practice and outlines potential policies that will strengthen the users-pay/users-benefit model of transportation funding. State Gas Tax Diversion Rates L L L","skipped":[{"docno":"msmarco_v2.1_doc_27_348866207#2_677699508","rank":2,"relevance":3}]},"time":10},"model_calls":43,"document_judgments":24,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
