{"actor":"server","event":"response","topic_id":"2024-23862","model_call":66,"request":{"op":"next","qid":"q3269"},"record":{"query":{"op":"next","qid":"q3269"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_03_650104618#13_1115806048","ok":true,"op":"next","qid":"q3269","rank":4,"snippet":" , \"headings\": \" \" , \"segment\": \"IT’S TIME TO UPHOLD THE WILL OF VOTERS AND CLOSE THE GAS TAX LOOPHOLE ONCE AND FOR ALL. YES ON 1A simply makes sure the gas taxes we pay at the pump are actually used to build new roads and improve our transportation system. Prop. 1A will not reduce funding for education or any other state program. Education funding is constitutionally protected and Proposition 1A does not change that. That’s why educators leading taxpayer, environmental, business, and public safety groups support Prop. 1A. Proposition 1A is part of the Rebuild California Plan, the first comprehensive infrastructure plan in 40 years. VOTE YES ON 1A. Ensure our existing <cover>gas tax dollars are used to improve California’s roads, highways, and mass transit systems. STEVE KRULL, President California Police </cover>Chiefs Association MARK WATTS, Interim Executive Director Transportation California ALLAN ZAREMBERG, President California Chamber of Commerce\" , \"start_char\": 7983.000000 , \"title\": \"Voter Information Guide\" , \"url\": \"http://vigarchive.sos.ca.gov/2006/general/props/prop1a/argue-rebutt.htm\" }"},"time":17},"model_calls":66,"document_judgments":41,"relevance_3":16,"max_document_judgments":50,"max_model_calls":100}
