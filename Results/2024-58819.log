{"actor":"server","event":"response","topic_id":"2024-58819","model_call":44,"request":{"op":"next","qid":"q1539"},"record":{"query":{"op":"next","qid":"q1539"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_02_580603816#1_1018219565","ok":true,"op":"next","qid":"q1539","rank":3,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_02_580603816#1_1018219565\" , \"end_char\": 3038.000000 , \"headings\": \"<cover>SCHOOL TRACKING HARMS MILLIONS, SOCIOLOGIST FINDS\" , \"segment\": \"\\\"At minimum, more students should be in higher tracks,\\\" Dornbusch </cover>said. Perhaps even more shocking, he said, are findings that students who intend  to go to college and their parents often don't know when a student has been  tracked out of college-preparatory science and math classes. Biology courses  with names like \"Ecology and You\" or \"Life on Earth\" hide the fact that they  will not prepare a student for admission to a four-year college. Similarly, a  student assigned to business math or other courses that teachers tend to  nickname \"bonehead\" math will find it hard to get back on track for admission  to a four-year college. School principals and teachers may not want students and parents to know  which courses are college preparation, Dornbusch suggested in his recent  inaugural address as president of the Society for Research on Adolescence. If  they knew, more students and parents would complain and demand better  placements, "},"time":1},"model_calls":44,"document_judgments":14,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
