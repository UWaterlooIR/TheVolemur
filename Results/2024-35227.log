{"actor":"server","event":"response","topic_id":"2024-35227","model_call":65,"request":{"op":"query","query":"(^ \"african rulers\" \"gold\" \"guns\" \"goods\")"},"record":{"query":{"op":"query","query":"(^ \"african rulers\" \"gold\" \"guns\" \"goods\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_53_75729873#11_135839513","ok":true,"op":"query","qid":"q3443","rank":1,"snippet":"Passage DOCUMENT-BASED  QUESTIONS Slavery  in  the  Americas Consequences  of  the  Slave  Trade TERMS  &  NAMES USING  YOUR  NOTES MAIN  IDEAS CONNECT  TO  TODAY CRITICAL  THINKING  &  WRITING \" , \"segment\": \"Often,  slaves  were  captured prisoners  of  war,  or  people  of  a different  nationality  or  religion. However,  the  slavery  that developed  in  the  Americas  was based  largely  on  race. Europeans viewed  black  people  as  naturally inferior. Because  of  this,  slavery  in the  Americas  was  hereditary. The  Atlantic  World 567 African  Cooperation  and  Resistance Many  African  rulers  and  merchants played  a  willing  role  in  the  Atlantic  slave  trade. Most  European  traders,  rather than  travel  inland,  waited  in  ports  along  the  coasts  of  Africa. African  merchants, with  the  help  of  local  rulers,  captured  Africans  to  be  enslaved. They  then  deliv- ered  them  to  the  Europeans  in  exchange  for <cover>gold,  guns,  and  other  goods. As  the  slave  trade  grew,  some  African  rulers </cover>voiced  their  opposition  to  the  prac- tice. Nonetheless,  the  slave  trade  steadily  grew.\" , \"start_char\": 6736.000000 , \"title\": \"\" , \"url\": \"https://www.sps186.org/downloads/basic/734100/ch20_3.pdf\" }","skipped":[{"docno":"msmarco_v2.1_doc_53_75729873#11_135839513","rank":1,"relevance":3}]},"time":48},"model_calls":65,"document_judgments":43,"relevance_3":29,"max_document_judgments":50,"max_model_calls":100}
