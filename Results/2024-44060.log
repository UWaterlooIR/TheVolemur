{"actor":"server","event":"request","topic_id":"2024-44060","model_call":38,"request":{"op":"next","qid":"q853"},"model_calls":38,"document_judgments":27,"relevance_3":18,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-44060","model_call":38,"request":{"op":"next","qid":"q853"},"record":{"query":{"op":"next","qid":"q853"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_54_109245095#1_277221339","ok":true,"op":"next","qid":"q853","rank":7,"snippet":"1377.000000 , \"headings\": \"Principles of Ingsoc Premium Essay Principles of Ingsoc Similar Documents Newspeak Metropolis and 1984 1984 to Today 1984 Orwell Ggfdgfdg The Hell of <cover>1984 \" , \"segment\": \"The main leader of this government was Big Brother. Newspeak was the official language of Oceania. INGSOC is English Socialism according to Newspeak language. There are three principles of INGSOC: War is Peace, Freedom is Slavery and Ignorance is Strength. War is peace is a belief that when a country is at war with some other country, the people and the states of the country get united to fight against their common enemy. In this novel, government used this principle to maintain peace in their country by being at war with Eurasia. This united the people of Oceania to fight with Eurasia. There are also some other examples of War is peace in this novel; during the two minute hate, when the face of Goldstein </cover>appeared on the screen and hate started, there were pictures of some Eurasian soldier and of the war.\" , \"start_char\": 561.000000 , \"title\":"},"time":14},"model_calls":38,"document_judgments":27,"relevance_3":18,"max_document_judgments":50,"max_model_calls":100}
