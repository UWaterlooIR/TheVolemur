{"actor":"server","event":"response","topic_id":"2024-44060","model_call":44,"request":{"op":"next","qid":"q855"},"record":{"query":{"op":"next","qid":"q855"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_12_822518523#1_1573292238","ok":true,"op":"next","qid":"q855","rank":6,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_12_822518523#1_1573292238\" , \"end_char\": 655.000000 , \"headings\": \" War is Peace. Freedom is Slavery. Ignorance is Strength. By: Monica Castro Leave a Reply Cancel reply \" , \"segment\": \"Ignorance is Strength. Posted: December 12, 2014 in Part I Tags: 1984analysis, 1984bygeorgeorwell, freedomisslavery, ignoranceisstrength, ingsocslogan, ingsocsloganmeaning, warispeace, warispeacefreedomisslaveryignoranceisstrength, warispeacequotemeaning 0 By: Monica Castro “War is Peace. Freedom Is Slavery. Ignorance is Strength.” These are three slogans of the Party, Ingsoc. But what do they mean? “War is Peace” means that while Oceania is at war with other countries, the people will maintain <cover>united because they have a common enemy.\" , \"start_char\": 115.000000 , \"title\": \"War is Peace. Freedom is Slavery. Ignorance is Strength. | 1984 </cover>by George Orwell\" , \"url\": \"https://backtothefuture1984.wordpress.com/2014/12/12/war-is-peace-freedom-is-slavery-ignorance-is-strength/\" }","skipped":[{"docno":"msmarco_v2.1_doc_06_873931060#14_1477673807","rank":5,"relevance":3}]},"time":8},"model_calls":44,"document_judgments":32,"relevance_3":22,"max_document_judgments":50,"max_model_calls":100}
