{"actor":"server","event":"response","topic_id":"2024-44060","model_call":44,"request":{"op":"next","qid":"q855"},"record":{"query":{"op":"next","qid":"q855"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_06_873931060#14_1477673807","ok":true,"op":"next","qid":"q855","rank":5,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_06_873931060#14_1477673807\" , \"end_char\": 8965.000000 , \"headings\": \"1984 Summary and Analysis of Part Two VIII-X 1984 by George Orwell<cover>1984 Summary and Analysis of Part Two VIII-X \" , \"segment\": \"Rather than being a war between nations, the war is waged upon the people to maintain loyalty, unity against a common enemy, and Party domination. Thus, as war maintains order in each individual nation, the meaning of the Party slogan \\\"War is Peace\\\" </cover>becomes clear. Julia arrives, briefly acknowledges the book, and busies herself making coffee. Half an hour later, while lying in bed, Winston tells Julia she must also read the book, and she asks him to read it aloud so that they can both take it in at the same time. He begins again at the first chapter. Goldstein discusses the pyramidal shape of society, which consists of the High, who wish to remain high, Middle, who wish to change places with the high, and Low, who wish to develop a society based on equality among all men. ","skipped":[{"docno":"msmarco_v2.1_doc_06_873931060#14_1477673807","rank":5,"relevance":3}]},"time":15},"model_calls":44,"document_judgments":32,"relevance_3":22,"max_document_judgments":50,"max_model_calls":100}
