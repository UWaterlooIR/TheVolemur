{"actor":"server","event":"response","topic_id":"2024-22410","model_call":21,"request":{"op":"next","qid":"q2710"},"record":{"query":{"op":"next","qid":"q2710"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_34_371377419#2_797926652","ok":true,"op":"next","qid":"q2710","rank":2,"snippet":"{ \"docid\": \"msmarco_v2.1_doc_34_371377419#2_797926652\" , \"end_char\": 1556.000000 , \"headings\": \"Do You Get Paid More With an Online Master’s Degree? Do You Get Paid More With an Online Master’s Degree? How Credible Are <cover>Online Degrees? Are Online Master’s Degrees Accepted by Employers?</cover>Is an Online Master’s Worth It? \" , \"segment\": \"How credible are online degrees? It depends on the college or university giving the degree. An online program at an accredited university is a credible degree. If the university or college is not accredited, then it is not a credible degree, and employers will not trust it. An accredited university must go through an evaluation from a third-party agency, which are designated by the federal Department of Education. The agency sets a clear standard that gives potential employers peace of mind that you have the training and education to handle the job. So how credible are online degrees? As credible as the online school’s accreditation. Are Online Master’s Degrees Accepted by Employers? Is an online master’s "},"time":15},"model_calls":21,"document_judgments":19,"relevance_3":15,"max_document_judgments":50,"max_model_calls":100}
