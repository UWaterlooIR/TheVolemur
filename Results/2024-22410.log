{"actor":"server","event":"response","topic_id":"2024-22410","model_call":39,"request":{"op":"next","qid":"q2716"},"record":{"query":{"op":"next","qid":"q2716"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_34_371377419#3_797927923","ok":true,"op":"next","qid":"q2716","rank":3,"snippet":"end_char\": 1949.000000 , \"headings\": \"Do You Get Paid More With an Online Master’s Degree? Do You Get Paid More With an Online Master’s Degree? How Credible Are Online Degrees? Are Online Master’s Degrees Accepted by Employers? Is an Online Master’s Worth It? \" , \"segment\": \"The agency sets a clear standard that gives potential employers peace of mind that you have the training and education to handle the job. So how credible are <cover>online degrees? As credible as the online school’s accreditation. Are Online Master’s Degrees Accepted by Employers? </cover>Is an online master’s worth it? Are online master’s degrees accepted by employers? It depends on the university and degree. An employer will consider an online degree from an accredited university in the same way employers view a degree at a traditional university. You will have the same opportunities and options for your career. If the university is not accredited, then an employer may determine that it is not credible.\" , \"start_char\": 1250.000000 , \"title\": \"Do You ","skipped":[{"docno":"msmarco_v2.1_doc_34_371377419#2_797926652","rank":2,"relevance":3}]},"time":5},"model_calls":39,"document_judgments":35,"relevance_3":23,"max_document_judgments":50,"max_model_calls":100}
