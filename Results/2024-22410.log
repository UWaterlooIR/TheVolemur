{"actor":"server","event":"response","topic_id":"2024-22410","model_call":39,"request":{"op":"next","qid":"q2716"},"record":{"query":{"op":"next","qid":"q2716"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_34_371377419#2_797926652","ok":true,"op":"next","qid":"q2716","rank":2,"snippet":"Online Master’s Degree? How Credible Are Online Degrees? Are Online Master’s Degrees Accepted by Employers? Is an Online Master’s Worth It? \" , \"segment\": \"How credible are online degrees? It depends on the college or university giving the degree. An online program at an accredited university is a credible degree. If the university or college is not accredited, then it is not a credible degree, and employers will not trust it. An accredited university must go through an evaluation from a third-party agency, which are designated by the federal Department of Education. The agency sets a clear standard that gives potential employers peace of mind that you have the training and education to handle the job. So how credible are <cover>online degrees? As credible as the online school’s accreditation. Are Online Master’s Degrees Accepted by Employers? </cover>Is an online master’s worth it?\" , \"start_char\": 832.000000 , \"title\": \"Do You Get Paid More With an Online Master's Degree? - BestMastersPrograms.org\" , \"url\": \"https://www.bestmastersprograms.org/online-masters-worth-it/\" }","skipped":[{"docno":"msmarco_v2.1_doc_34_371377419#2_797926652","rank":2,"relevance":3}]},"time":15},"model_calls":39,"document_judgments":35,"relevance_3":23,"max_document_judgments":50,"max_model_calls":100}
