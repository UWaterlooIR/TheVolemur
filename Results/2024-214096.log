{"actor":"server","event":"response","topic_id":"2024-214096","model_call":35,"request":{"op":"query","query":"(^ marijuana side effects drowsiness \"increased appetite\")"},"record":{"query":{"op":"query","query":"(^ marijuana side effects drowsiness \"increased appetite\")"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_46_253845474#0_615401161","ok":true,"op":"query","qid":"q641","rank":1,"snippet":"Medical content reviewed by Dr. Joseph Rosado, MD, M.B.A, Chief Medical Officer Why Does Marijuana Make You Tired As a medical marijuana patient, you may deal with frequent drowsiness due to your medication. Or, perhaps you want to try cannabis medicine, but you worry it will make you too tired to function. Either way, you want to know everything you can about cannabis and tiredness so you can medicate yourself in the best way possible. While marijuana can cause drowsiness, there are of ways to manage it. We’ll give you the low-down. About Medical Marijuana Side Effects Just like any other medication, weed can cause unwanted side effects. But, due to its versatility, medical marijuana has some side effects that certain patients consider a benefit. For instance, some folks want marijuana to make them tired so they can get a good night’s rest. Other possibly beneficial side effects include <cover>increased appetite and reduced saliva production.\" , \"start_char\": 0.000000 , \"title\": \"Drowsiness from Cannabis | Medical Marijuana Side Effects</cover>\" , \"url\": \"https://www.marijuanadoctors.com/side-effects/drowsiness/\" }","skipped":[{"docno":"msmarco_v2.1_doc_46_253845474#0_615401161","rank":1,"relevance":3}]},"time":395},"model_calls":35,"document_judgments":21,"relevance_3":9,"max_document_judgments":50,"max_model_calls":100}
