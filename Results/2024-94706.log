{"actor":"server","event":"response","topic_id":"2024-94706","model_call":12,"request":{"op":"next","qid":"q3198"},"record":{"query":{"op":"next","qid":"q3198"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_04_617638138#1_1359518224","ok":true,"op":"next","qid":"q3198","rank":2,"snippet":"is special Eastern religions Freedom from mortal life Non-harm - the principle of ahimsa The sanctity of life \" , \"segment\": \"All faiths offer meaning and explanations for death and dying; all faiths try to find a place for death and dying within human experience. For those left behind when someone dies religions provide rituals to mark death, and ceremonies to remember those who have died. Religions provide understanding and comfort for those who are facing death. Religions regard understanding death and dying as vital to finding meaning in human life. Dying is often seen as an occasion for getting powerful spiritual insights as well as for preparing for whatever afterlife may be to come. So it's not surprising that all faiths have strong views on euthanasia. Religious <cover>views on euthanasia: Buddhism Christian Roman Catholic Hindu</cover>Islam Judaism Sikhism Religions and euthanasia Most religions disapprove of euthanasia. Some of them absolutely forbid it.\" , \"start_char\": 459.000000 , \"title\": \"BBC - Ethics - Euthanasia: Religion and euthanasia\" , \"url\": \"http://www.bbc.co.uk/ethics/euthanasia/religion/religion.shtml\" }"},"time":9},"model_calls":12,"document_judgments":9,"relevance_3":3,"max_document_judgments":50,"max_model_calls":100}
