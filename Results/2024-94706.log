{"actor":"server","event":"response","topic_id":"2024-94706","model_call":20,"request":{"op":"query","query":"(^ euthanasia buddhism (+ views ethics attitude) (+ christian western))"},"record":{"query":{"op":"query","query":"(^ euthanasia buddhism (+ views ethics attitude) (+ christian western))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_04_617638138#1_1359518224","ok":true,"op":"query","qid":"q3205","rank":1,"snippet":"is special Eastern religions Freedom from mortal life Non-harm - the principle of ahimsa The sanctity of life \" , \"segment\": \"All faiths offer meaning and explanations for death and dying; all faiths try to find a place for death and dying within human experience. For those left behind when someone dies religions provide rituals to mark death, and ceremonies to remember those who have died. Religions provide understanding and comfort for those who are facing death. Religions regard understanding death and dying as vital to finding meaning in human life. Dying is often seen as an occasion for getting powerful spiritual insights as well as for preparing for whatever afterlife may be to come. So it's not surprising that all faiths have strong views on euthanasia. Religious <cover>views on euthanasia: Buddhism Christian</cover>Roman Catholic Hindu Islam Judaism Sikhism Religions and euthanasia Most religions disapprove of euthanasia. Some of them absolutely forbid it.\" , \"start_char\": 459.000000 , \"title\": \"BBC - Ethics - Euthanasia: Religion and euthanasia\" , \"url\": \"http://www.bbc.co.uk/ethics/euthanasia/religion/religion.shtml\" }","skipped":[{"docno":"msmarco_v2.1_doc_04_617638138#1_1359518224","rank":1,"relevance":3}]},"time":95},"model_calls":20,"document_judgments":15,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"request","topic_id":"2024-94706","model_call":20,"request":{"op":"next","qid":"q3205"},"model_calls":20,"document_judgments":15,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
{"actor":"server","event":"response","topic_id":"2024-94706","model_call":20,"request":{"op":"next","qid":"q3205"},"record":{"query":{"op":"next","qid":"q3205"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_04_617638138#2_1359519668","ok":true,"op":"next","qid":"q3205","rank":2,"snippet":": \"Religion and euthanasia Religion and euthanasia On this page Religion and euthanasia Religions and death Religious views on euthanasia: Religions and euthanasia God has forbidden it Human life is sacred Human life is special Eastern religions Freedom from mortal life Non-harm - the principle of ahimsa The sanctity of life \" , \"segment\": \"Dying is often seen as an occasion for getting powerful spiritual insights as well as for preparing for whatever afterlife may be to come. So it's not surprising that all faiths have strong views on euthanasia. Religious <cover>views on euthanasia: Buddhism Christian</cover>Roman Catholic Hindu Islam Judaism Sikhism Religions and euthanasia Most religions disapprove of euthanasia. Some of them absolutely forbid it. The Roman Catholic church, for example, is one of the most active organisations in opposing euthanasia. Virtually all religions state that those who become vulnerable through illness or disability deserve special care and protection, and that proper end of life care is a much better thing than euthanasia. Religions are opposed to euthanasia for a number of reasons. God has forbidden it virtually all religions with a supreme God have a command from God in their scriptures that ","skipped":[{"docno":"msmarco_v2.1_doc_04_617638138#2_1359519668","rank":2,"relevance":3}]},"time":6},"model_calls":20,"document_judgments":15,"relevance_3":4,"max_document_judgments":50,"max_model_calls":100}
