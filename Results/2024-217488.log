{"actor":"server","event":"response","topic_id":"2024-217488","model_call":21,"request":{"op":"query","query":"(^ \"everyone is watching\" (+ \"social anxiety\" \"spotlight effect\" self-conscious))"},"record":{"query":{"op":"query","query":"(^ \"everyone is watching\" (+ \"social anxiety\" \"spotlight effect\" self-conscious))"},"response":{"burrow":"/data/ssd3/claclark/msm-2.1.burrow","docno":"msmarco_v2.1_doc_50_459261864#5_922759722","ok":true,"op":"query","qid":"q3756","rank":1,"snippet":"a problem that affects your mind, body, and life. \" , \"segment\": \"See if your worrying turns to anger. ( I discuss this technique in depth in my book.) 3. Anxious around other people? It could be social anxiety. At home, your anxiety subsides. But when you're around other people, or there's an event coming up where you'll have to interact with others or speak publicly, your anxiety goes into overdrive. If you spend the week before a party thinking about every little thing that may go wrong, or you avoid going, or you dwell on everything you said or did afterward, you may have social anxiety. Symptoms include stomach aches, muscle aches, a sped-up heart rate, and the feeling that <cover>everyone is watching and judging you. If you think you might have social anxiety, </cover>try meditating before you go out:\" , \"start_char\": 2114.000000 , \"title\": \"5 Things You Need to Know About Anxiety | Psychology Today\" , \"url\": \"https://www.psychologytoday.com/us/blog/mindful-anger/201705/5-things-you-need-know-about-anxiety\" }"},"time":229},"model_calls":21,"document_judgments":17,"relevance_3":8,"max_document_judgments":50,"max_model_calls":100}
